@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IStringLocalizer<AppStrings> L

@* The admin shell: a permanent rail from lg up, a temporary drawer below it.
   MudDrawer handles the overlay, the scroll lock and focus containment; the
   editorial styling is all in pages.css under .pg-admin-*. *@
<MudLayout Class="pg-admin">
    <MudAppBar Elevation="0" Fixed="true" Class="pg-admin__bar">
        <OsIconButton Icon="@Icons.Material.Outlined.Menu"
                      AriaLabel="@L["Admin.ToggleMenuAria"]"
                      OnClick="ToggleDrawer"
                      Class="pg-admin__burger" />
        <a href="/admin" class="pg-admin__brand">
            <span class="pg-admin__brand-name">OrderSphere</span>
            <span class="pg-admin__brand-tag os-mono">@L["Admin.Nav.Section"]</span>
        </a>
        <MudSpacer />
        <ThemeToggle />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Elevation="0"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Lg"
               ClipMode="DrawerClipMode.Always"
               Class="pg-admin__rail">

        <nav class="pg-admin__nav" aria-label="@L["Admin.Nav.Section"]">
            <MudNavMenu>
                <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">
                    @L["Admin.Nav.Dashboard"]
                </MudNavLink>
                <MudNavLink Href="/admin/orders" Icon="@Icons.Material.Outlined.Receipt">
                    @L["Admin.Nav.Orders"]
                </MudNavLink>
                <MudNavLink Href="/admin/invoices" Icon="@Icons.Material.Outlined.ReceiptLong">
                    @L["Admin.Nav.Invoices"]
                </MudNavLink>
                <MudNavLink Href="/admin/products" Icon="@Icons.Material.Outlined.Inventory2">
                    @L["Admin.Nav.Products"]
                </MudNavLink>
                <MudNavLink Href="/admin/categories" Icon="@Icons.Material.Outlined.Category">
                    @L["Admin.Nav.Categories"]
                </MudNavLink>
                <MudNavLink Href="/admin/coupons" Icon="@Icons.Material.Outlined.LocalOffer">
                    @L["Admin.Nav.Coupons"]
                </MudNavLink>
                <MudNavLink Href="/admin/reviews" Icon="@Icons.Material.Outlined.RateReview">
                    @L["Admin.Nav.Reviews"]
                </MudNavLink>
                <MudNavLink Href="/admin/users" Icon="@Icons.Material.Outlined.Group">
                    @L["Admin.Nav.Customers"]
                </MudNavLink>
            </MudNavMenu>
        </nav>

        <div class="pg-admin__rail-foot">
            <OsButton Href="/shop"
                      Variant="OsButton.ButtonVariant.Secondary"
                      FullWidth="true"
                      StartIcon="@Icons.Material.Outlined.Storefront">
                @L["Admin.Nav.ToShop"]
            </OsButton>
            <OsButton Variant="OsButton.ButtonVariant.Ghost"
                      FullWidth="true"
                      StartIcon="@Icons.Material.Outlined.Logout"
                      Loading="_isLoggingOut"
                      OnClick="HandleLogout">
                @L["Account.Logout"]
            </OsButton>
        </div>
    </MudDrawer>

    <MudMainContent>
        <AppErrorBoundary>
            <PageTransition>
                @Body
            </PageTransition>
        </AppErrorBoundary>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isLoggingOut;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task HandleLogout()
    {
        _isLoggingOut = true;
        try { await Http.PostAsync("/bff/logout", content: null); } catch { }
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
