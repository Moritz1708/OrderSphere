@implements IDisposable
@inject NavigationManager Nav
@inject IStringLocalizer<AppStrings> L

@* Wraps page content so an unhandled component exception shows a recoverable fallback
   instead of tearing down the whole app. The built-in ErrorBoundary already logs the
   exception via ILogger; this wrapper adds a branded fallback and auto-recovers on navigation. *@
<ErrorBoundary @ref="_boundary">
    <ChildContent>
        @ChildContent
    </ChildContent>
    <ErrorContent>
        <OsSection Width="OsSection.SectionWidth.Narrow" Padding="OsSection.SectionPadding.Lg">
            <OsEmptyState Icon="@Icons.Material.Outlined.ErrorOutline"
                          Title="@L["Error.BoundaryTitle"]"
                          Body="@L["Error.BoundaryBody"]"
                          ActionText="@L["Common.Retry"]"
                          ActionIcon="@Icons.Material.Outlined.Refresh"
                          OnAction="Recover" />
        </OsSection>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ErrorBoundary? _boundary;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _boundary?.Recover();

    private void Recover() => _boundary?.Recover();

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
