@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L

<MudAppBar Elevation="0" Fixed="true" Class="os-header">

    @* Below md the links collapse into the drawer, so the trigger comes first. *@
    <OsIconButton Icon="@Icons.Material.Outlined.Menu"
                  AriaLabel="@L["Nav.MenuOpen"]"
                  Class="os-header__burger"
                  OnClick="() => OnMobileNavToggle.InvokeAsync()" />

    @* A plain anchor, not MudLink: Mud's colour utilities (mud-primary-text) are
       declared !important, which outranks our layer regardless of cascade order. *@
    <a href="/" class="os-header__brand">
        <span class="os-logo-mark" aria-hidden="true">○</span>
        <span class="os-header__wordmark">OrderSphere</span>
    </a>

    <nav class="os-header__nav" aria-label="@L["Nav.Primary"]">
        <NavLink href="/shop" class="os-header__link" ActiveClass="is-active">@L["Nav.Shop"]</NavLink>
        <NavLink href="/categories" class="os-header__link" ActiveClass="is-active">@L["Nav.Categories"]</NavLink>
    </nav>

    <div class="os-header__search">
        <OsSearchBar />
    </div>

    <MudSpacer />

    <div class="os-header__actions">
        <LocaleMenu />
        <ThemeToggle />

        <span class="os-header__cart">
            <OsIconButton Icon="@Icons.Material.Outlined.ShoppingCart"
                          AriaLabel="@L["Cart.AriaLabel", CartItemCount]"
                          Pressed="IsCartOpen"
                          OnClick="OnCartToggle" />
            <OsBadge Count="CartItemCount" />
        </span>

        <AuthorizeView>
            <Authorized>
                <AccountMenu Name="@context.User.Identity?.Name"
                             Email="@context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value"
                             IsAdmin="@context.User.IsInRole("admin")" />
            </Authorized>
            <NotAuthorized>
                <OsButton OnClick="() => LoginRedirect.Go(Navigation)"
                          Variant="OsButton.ButtonVariant.Secondary"
                          Size="OsButton.ButtonSize.Sm">
                    @L["Auth.SignIn"]
                </OsButton>
            </NotAuthorized>
        </AuthorizeView>
    </div>

</MudAppBar>

@code {
    [Parameter] public EventCallback OnCartToggle { get; set; }
    [Parameter] public EventCallback OnMobileNavToggle { get; set; }
    [Parameter] public int CartItemCount { get; set; }
    [Parameter] public bool IsCartOpen { get; set; }
}
