@implements IDisposable
@using System.Text.Json
@inject IAdvisorClient Advisor
@inject ILogger<AdvisorDrawer> Logger
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IStringLocalizer<AppStrings> L

<MudDrawer @bind-Open="IsOpen"
           Anchor="Anchor.Right"
           Elevation="0"
           Variant="DrawerVariant.Temporary"
           Width="440px"
           ClipMode="DrawerClipMode.Never"
           Class="os-advisor">

    <header class="os-advisor__head">
        <div class="os-advisor__title">
            <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3">@L["Advisor.Title"]</OsDisplay>
            <span class="os-advisor__id os-mono">
                @L["Advisor.Conversation"] @_conversationId[..8].ToUpperInvariant()
            </span>
        </div>
        <div class="os-advisor__tools">
            <OsIconButton Icon="@Icons.Material.Outlined.Add"
                          Size="OsIconButton.IconButtonSize.Sm"
                          OnClick="NewChat"
                          AriaLabel="@L["Advisor.NewChatAria"]" />
            <OsIconButton Icon="@Icons.Material.Outlined.History"
                          Size="OsIconButton.IconButtonSize.Sm"
                          Pressed="_showHistory"
                          OnClick="ToggleHistoryAsync"
                          AriaLabel="@L["Advisor.ToggleHistoryAria"]" />
            <OsIconButton Icon="@Icons.Material.Outlined.Close"
                          Size="OsIconButton.IconButtonSize.Sm"
                          OnClick="Close"
                          AriaLabel="@L["Advisor.CloseAria"]" />
        </div>
    </header>

    @if (_showHistory)
    {
        <div class="os-advisor__body">
            <OsEyebrow Text="@L["Advisor.HistoryTitle"]" />
            @if (_loadingHistory)
            {
                <OsListSkeleton Rows="4" />
            }
            else if (_conversations.Count == 0)
            {
                <OsEmptyState Icon="@Icons.Material.Outlined.Forum"
                              Title="@L["Advisor.HistoryEmpty"]"
                              Compact="true" />
            }
            else
            {
                <div class="os-rows">
                    @foreach (var c in _conversations)
                    {
                        <button type="button"
                                class="os-row os-advisor__conv @(c.ConversationId == _conversationId ? "is-current" : null)"
                                @key="c.ConversationId"
                                @onclick="@(() => SelectConversationAsync(c.ConversationId))">
                            <span class="os-row__main">
                                <span class="os-row__title os-truncate">
                                    @(string.IsNullOrWhiteSpace(c.LastMessage) ? L["Advisor.HistoryUntitled"] : c.LastMessage)
                                </span>
                                <span class="os-row__meta os-mono">
                                    @c.UpdatedAt.ToLocalTime().ToString("g") · @L["Advisor.HistoryMessages", c.MessageCount]
                                </span>
                            </span>
                        </button>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="os-advisor__body">
            @if (_messages.Count == 0)
            {
                <div class="os-advisor__empty">
                    <OsDisplay As="p" Size="OsDisplay.DisplaySize.D3">@L["Advisor.Greeting"]</OsDisplay>
                    <p class="os-advisor__empty-body">@L["Advisor.EmptyBody"]</p>
                    <div class="os-advisor__suggestions">
                        @foreach (var key in Suggestions)
                        {
                            <button type="button" class="os-advisor__suggestion" @key="key"
                                    @onclick="@(() => SendSuggestionAsync(L[key]))">
                                @L[key]
                            </button>
                        }
                    </div>
                </div>
            }
            else
            {
                @* Pushed to the bottom so a short conversation sits above the composer
                   rather than floating in the middle of the drawer. *@
                <div class="os-advisor__thread">
                    @foreach (var m in _messages)
                    {
                        <div class="os-msg os-advisor__msg @(m.IsUser ? "is-user" : "is-assistant")" @key="m">
                            <p class="os-advisor__msg-text">@m.Text</p>

                            @if (!m.IsUser && !string.IsNullOrEmpty(m.Text))
                            {
                                <div class="os-advisor__msg-foot">
                                    <OsIconButton Icon="@Icons.Material.Outlined.VolumeUp"
                                                  Size="OsIconButton.IconButtonSize.Sm"
                                                  OnClick="@(() => SpeakAsync(m.Text))"
                                                  AriaLabel="@L["Advisor.SpeakAria"]" />
                                </div>
                            }

                            @if (!m.IsUser && m.Citations is { Count: > 0 })
                            {
                                <div class="os-advisor__cites">
                                    @foreach (var c in m.Citations)
                                    {
                                        @* /p/{slug} is the product alias route; /products/{slug}
                                           was a 404 for every citation the advisor produced. *@
                                        <a class="os-advisor__cite" href="@($"/p/{c.Slug}")"
                                           @key="c.Slug" @onclick="CloseOnNavigate" @onclick:preventDefault="false">
                                            @c.Name
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (_toolActivity is not null)
                    {
                        <div class="os-advisor__activity os-mono" role="status">
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                            <span>@_toolActivity…</span>
                        </div>
                    }

                    @if (_pendingConfirm is not null)
                    {
                        <div class="os-msg os-advisor__confirm">
                            <OsEyebrow Text="@L["Advisor.ConfirmTitle"]" Rule="false" />
                            <p class="os-advisor__msg-text">@_pendingConfirm.Summary</p>
                            <div class="os-advisor__confirm-actions">
                                <OsButton Size="OsButton.ButtonSize.Sm" Disabled="_busy" OnClick="ConfirmAddToCartAsync">
                                    @L["Advisor.ConfirmYes"]
                                </OsButton>
                                <OsButton Size="OsButton.ButtonSize.Sm" Variant="OsButton.ButtonVariant.Ghost"
                                          Disabled="_busy" OnClick="CancelAddToCartAsync">
                                    @L["Advisor.ConfirmNo"]
                                </OsButton>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="os-advisor__composer">
            <MudTextField @bind-Value="_input"
                          Placeholder="@L["Advisor.InputPlaceholder"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          OnKeyDown="OnKeyDown"
                          Disabled="_busy"
                          Class="os-advisor__input" />
            <OsIconButton Icon="@(_recording ? Icons.Material.Filled.MicOff : Icons.Material.Filled.Mic)"
                          Size="OsIconButton.IconButtonSize.Md"
                          Pressed="_recording"
                          OnClick="ToggleRecordingAsync"
                          Disabled="@(_busy && !_recording)"
                          AriaLabel="@(_recording ? L["Advisor.StopRecordingAria"] : L["Advisor.StartRecordingAria"])" />
            <OsIconButton Icon="@Icons.Material.Filled.Send"
                          Size="OsIconButton.IconButtonSize.Md"
                          Variant="OsIconButton.IconButtonVariant.Secondary"
                          OnClick="SendAsync"
                          Disabled="@(_busy || string.IsNullOrWhiteSpace(_input))"
                          AriaLabel="@L["Advisor.SendAria"]" />
        </div>
    }
</MudDrawer>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private static readonly string[] Suggestions =
        ["Advisor.Suggest1", "Advisor.Suggest2", "Advisor.Suggest3"];

    private sealed class ChatMessage
    {
        public bool IsUser { get; init; }
        public string Text { get; set; } = string.Empty;
        public List<AdvisorCitationItem>? Citations { get; set; }
    }

    private readonly List<ChatMessage> _messages = [];
    private List<AdvisorConversation> _conversations = [];
    private string _conversationId = Guid.NewGuid().ToString("n");
    private string _input = string.Empty;
    private string? _toolActivity;
    private AdvisorConfirmPayload? _pendingConfirm;
    private bool _busy;
    private bool _showHistory;
    private bool _loadingHistory;
    private bool _recording;
    private CancellationTokenSource? _cts;

    private static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendAsync();
        }
    }

    private async Task SendSuggestionAsync(string text)
    {
        _input = text;
        await SendAsync();
    }

    private async Task SendAsync()
    {
        var text = _input?.Trim();
        if (string.IsNullOrEmpty(text) || _busy)
        {
            return;
        }

        _busy = true;
        _pendingConfirm = null;
        _input = string.Empty;
        _messages.Add(new ChatMessage { IsUser = true, Text = text });

        var reply = new ChatMessage { IsUser = false, Text = string.Empty };
        _messages.Add(reply);
        StateHasChanged();

        _cts = new CancellationTokenSource();
        try
        {
            await foreach (var item in Advisor.StreamAsync(_conversationId, text, _cts.Token))
            {
                if (item.Kind == AdvisorStreamItemKind.Tool)
                {
                    _toolActivity = item.Text;
                }
                else if (item.Kind == AdvisorStreamItemKind.Confirm)
                {
                    _toolActivity = null;
                    try
                    {
                        _pendingConfirm = JsonSerializer.Deserialize<AdvisorConfirmPayload>(item.Text, JsonOpts);
                    }
                    catch
                    {
                        // Malformed payload; fall back to showing raw text
                        reply.Text = item.Text;
                    }
                    if (_pendingConfirm is not null)
                        _messages.Remove(reply); // Remove empty assistant bubble
                }
                else if (item.Kind == AdvisorStreamItemKind.Citation)
                {
                    try
                    {
                        reply.Citations = JsonSerializer.Deserialize<List<AdvisorCitationItem>>(item.Text, JsonOpts);
                    }
                    catch
                    {
                        // Malformed citation payload — omit silently.
                    }
                }
                else
                {
                    _toolActivity = null;
                    reply.Text += item.Text;
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Advisor chat request failed; showing the fallback reply.");
            reply.Text = L["Advisor.Unavailable"];
        }
        finally
        {
            _toolActivity = null;
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task ToggleHistoryAsync()
    {
        _showHistory = !_showHistory;
        if (_showHistory)
        {
            _loadingHistory = true;
            StateHasChanged();
            try
            {
                _conversations = [.. await Advisor.GetConversationsAsync()];
            }
            catch (Exception)
            {
                _conversations = [];
            }
            finally
            {
                _loadingHistory = false;
            }
        }
    }

    private async Task SelectConversationAsync(string conversationId)
    {
        _showHistory = false;
        _conversationId = conversationId;
        _messages.Clear();
        StateHasChanged();
        try
        {
            var history = await Advisor.GetMessagesAsync(conversationId);
            foreach (var m in history)
            {
                _messages.Add(new ChatMessage
                {
                    IsUser = string.Equals(m.Role, "user", StringComparison.OrdinalIgnoreCase),
                    Text = m.Text
                });
            }
        }
        catch (Exception)
        {
            // Leave the conversation empty if it can't be loaded.
        }
        StateHasChanged();
    }

    private void NewChat()
    {
        _showHistory = false;
        _conversationId = Guid.NewGuid().ToString("n");
        _messages.Clear();
        _input = string.Empty;
    }

    private async Task ConfirmAddToCartAsync()
    {
        if (_pendingConfirm is null) return;
        var confirm = _pendingConfirm;
        _pendingConfirm = null;
        // Sent in the user's language: the model reads both, and everything else
        // the user types is in their language anyway.
        _input = L["Advisor.ConfirmedMessage", confirm.ProductName, confirm.Quantity, confirm.Slug];
        await SendAsync();
    }

    private async Task CancelAddToCartAsync()
    {
        _pendingConfirm = null;
        _input = L["Advisor.CancelledMessage"];
        await SendAsync();
    }

    private Task CloseOnNavigate() => IsOpenChanged.InvokeAsync(false);

    private async Task ToggleRecordingAsync()
    {
        if (_recording)
        {
            _recording = false;
            StateHasChanged();
            try
            {
                var wavBytes = await JS.InvokeAsync<byte[]>("advisorVoice.stopRecording");
                if (wavBytes is { Length: > 44 })
                {
                    var text = await Advisor.TranscribeAsync(wavBytes);
                    if (!string.IsNullOrWhiteSpace(text))
                    {
                        _input = text;
                        StateHasChanged();
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Voice transcription failed");
            }
        }
        else
        {
            try
            {
                await JS.InvokeVoidAsync("advisorVoice.startRecording");
                _recording = true;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not start recording — microphone access denied");
            }
        }
    }

    private async Task SpeakAsync(string text)
    {
        try
        {
            var audio = await Advisor.SynthesizeAsync(text);
            if (audio is { Length: > 0 })
            {
                var base64 = Convert.ToBase64String(audio);
                await JS.InvokeVoidAsync("advisorVoice.playAudio", base64);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Voice synthesis failed");
        }
    }

    private void Close() => IsOpenChanged.InvokeAsync(false);

    public void Dispose() => _cts?.Cancel();
}
