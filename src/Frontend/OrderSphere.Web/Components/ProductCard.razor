@inject IStringLocalizer<AppStrings> L

@* Catalogue tile. The whole card opens the product; the add button stops the
   click from bubbling so it can act on its own. *@
<article class="os-card os-card--paper os-card--pad-none os-product-card"
         role="button"
         tabindex="0"
         aria-label="@Product.Name"
         @onclick="HandleOpen"
         @onkeydown="HandleKeyDown">

    <div class="os-product-card__image">
        <OsProductImage Product="Product" />
        @if (Product.Stock == 0)
        {
            <span class="os-product-card__flag">
                <OsStatusChip Tone="StatusTone.Danger" Text="@L["Common.SoldOut"]" Size="OsStatusChip.ChipSize.Sm" />
            </span>
        }
    </div>

    <div class="os-product-card__body">
        @if (ShowCategory && !string.IsNullOrWhiteSpace(Product.CategoryName))
        {
            <OsEyebrow Text="@Product.CategoryName" Tone="OsEyebrow.EyebrowTone.Muted" Rule="false" />
        }

        <h3 class="os-product-card__name">@Product.Name</h3>

        @if (Product.ReviewCount > 0)
        {
            <StarRating Value="Product.AverageRating" Count="Product.ReviewCount" />
        }

        @if (!string.IsNullOrWhiteSpace(Product.Description))
        {
            <p class="os-product-card__desc os-clamp-2">@Product.Description</p>
        }

        <div class="os-product-card__foot">
            <OsPrice Value="Product.Price" />
            <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                <OsIconButton Icon="@Icons.Material.Outlined.Add"
                              AriaLabel="@L["Common.AddToCart"]"
                              Variant="OsIconButton.IconButtonVariant.Secondary"
                              Class="product-add-btn"
                              Disabled="@(Product.Stock == 0)"
                              OnClick="HandleAdd" />
            </span>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public ProductDto Product { get; set; } = default!;
    [Parameter] public EventCallback<ProductDto> OnOpen { get; set; }
    [Parameter] public EventCallback<ProductDto> OnAdd { get; set; }
    [Parameter] public bool ShowCategory { get; set; }

    private Task HandleOpen() => OnOpen.InvokeAsync(Product);

    private Task HandleAdd() => OnAdd.InvokeAsync(Product);

    private Task HandleKeyDown(KeyboardEventArgs e) =>
        e.Key is "Enter" or " " ? HandleOpen() : Task.CompletedTask;
}
