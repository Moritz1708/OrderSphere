@inject IUserProfileClient UserProfile
@inject NavigationManager Nav
@inject IStringLocalizer<AppStrings> L

<MudDialog>
    <TitleContent>@L["OnboardingPrompt.Title"]</TitleContent>
    <DialogContent>
        <p class="os-confirm__message">@L["OnboardingPrompt.Message"]</p>
    </DialogContent>
    <DialogActions>
        <OsButton Variant="OsButton.ButtonVariant.Ghost" Disabled="_busy" OnClick="SkipAsync">
            @L["OnboardingPrompt.Skip"]
        </OsButton>
        <OsButton Disabled="_busy" OnClick="Complete">
            @L["OnboardingPrompt.Complete"]
        </OsButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private bool _busy;

    private void Complete()
    {
        MudDialog.Close(DialogResult.Ok(true));
        Nav.NavigateTo("/onboarding");
    }

    private async Task SkipAsync()
    {
        _busy = true;
        try
        {
            await UserProfile.SkipOnboardingAsync();
        }
        finally
        {
            _busy = false;
        }
        MudDialog.Close(DialogResult.Ok(false));
    }
}
