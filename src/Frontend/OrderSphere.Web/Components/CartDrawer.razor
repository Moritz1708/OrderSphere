@implements IDisposable
@inject CartState CartState
@inject IOrderingClient Ordering
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L

<MudDrawer @bind-Open="IsOpen"
           Anchor="Anchor.Right"
           Elevation="0"
           Variant="DrawerVariant.Temporary"
           Width="min(92vw, 440px)"
           ClipMode="DrawerClipMode.Never"
           Class="os-cart">

    <div class="os-cart__head">
        <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3">@L["Cart.Title"]</OsDisplay>
        <OsIconButton Icon="@Icons.Material.Outlined.Close"
                      AriaLabel="@L["Cart.CloseAria"]"
                      OnClick="Close" />
    </div>

    @if (_items.Count == 0)
    {
        <div class="os-cart__empty">
            <OsEmptyState Icon="@Icons.Material.Outlined.ShoppingCart"
                          Title="@L["Cart.Empty"]"
                          ActionText="@L["Cart.ToShop"]"
                          ActionHref="/shop"
                          OnAction="Close"
                          Compact="true" />
        </div>
    }
    else
    {
        <div class="os-cart__items os-rows">
            @foreach (var item in _items)
            {
                <div class="os-row" @key="item.ProductId">
                    <OsProductImage Seed="item.ProductId" Name="@item.ProductName" Ratio="1/1" Class="os-cart__thumb" />
                    <div class="os-row__main">
                        <span class="os-row__title os-truncate">@item.ProductName</span>
                        <span class="os-row__meta os-num">@item.Quantity × @Formatting.Currency(item.Price)</span>
                    </div>
                    <div class="os-row__end">
                        <OsPrice Value="item.Quantity * item.Price" Size="OsPrice.PriceSize.Sm" />
                        <OsIconButton Icon="@Icons.Material.Outlined.Close"
                                      Size="OsIconButton.IconButtonSize.Sm"
                                      AriaLabel="@L["Cart.RemoveAria", item.ProductName]"
                                      OnClick="@(() => RemoveAsync(item.ProductId))" />
                    </div>
                </div>
            }
        </div>

        <div class="os-cart__foot">
            <dl class="os-kv">
                <div class="os-kv__row os-kv__row--total">
                    <dt class="os-kv__key">@L["Cart.Total"]</dt>
                    <dd class="os-kv__val">@Formatting.Currency(_total)</dd>
                </div>
            </dl>

            <OsButton FullWidth="true" Size="OsButton.ButtonSize.Lg" OnClick="GoToCheckout">
                @L["Cart.ToCheckout"]
            </OsButton>
            <OsButton Variant="OsButton.ButtonVariant.Ghost" FullWidth="true" Href="/cart" OnClick="Close">
                @L["Cart.ViewCart"]
            </OsButton>
        </div>
    }
</MudDrawer>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private List<CartItemDto> _items = [];
    private decimal _total;

    protected override void OnInitialized()
    {
        CartState.OnChange += Refresh;
        Refresh();
    }

    private void Refresh()
    {
        _items = CartState.Cart?.Items ?? [];
        _total = _items.Sum(i => i.Quantity * i.Price);
        InvokeAsync(StateHasChanged);
    }

    private async Task RemoveAsync(Guid productId)
    {
        var result = await Ordering.RemoveFromCartAsync(productId);
        if (!result.IsSuccess)
            Snackbar.ShowApiError(result.Error);
        await CartState.RefreshAsync();
    }

    private void GoToCheckout()
    {
        IsOpenChanged.InvokeAsync(false);
        Navigation.NavigateTo("/checkout");
    }

    private void Close() => IsOpenChanged.InvokeAsync(false);

    public void Dispose() => CartState.OnChange -= Refresh;
}
