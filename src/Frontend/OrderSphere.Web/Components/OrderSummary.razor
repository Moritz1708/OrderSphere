@* Order-summary card shared by the cart and checkout pages. Set ShowLineItems to
   render the itemised list above the totals; page-specific buttons and notes go
   into the Actions fragment. *@
@inject IStringLocalizer<AppStrings> L

<aside class="os-card os-card--paper os-card--pad-lg os-summary" style="@($"position:sticky;top:calc(var(--os-header-h) + {StickyTop});")">
    <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3" Class="os-summary__title">@(Title ?? L["OrderSummary.Title"])</OsDisplay>

    @if (ShowLineItems && Items.Count > 0)
    {
        <div class="os-rows os-summary__items">
            @foreach (var item in Items)
            {
                <div class="os-row">
                    <div class="os-row__main">
                        <span class="os-row__title">@item.ProductName</span>
                        <span class="os-row__meta">@L["OrderSummary.Quantity", item.Quantity]</span>
                    </div>
                    <OsPrice Value="item.Price * item.Quantity" Size="OsPrice.PriceSize.Sm" />
                </div>
            }
        </div>
    }

    @if (CouponSlot is not null)
    {
        <div class="os-summary__coupon">@CouponSlot</div>
    }

    <dl class="os-kv">
        <div class="os-kv__row">
            <dt class="os-kv__key">@L["OrderSummary.Subtotal"]</dt>
            <dd class="os-kv__val">@Formatting.Currency(Subtotal)</dd>
        </div>
        @if (Discount > 0)
        {
            <div class="os-kv__row">
                <dt class="os-kv__key">@(DiscountLabel ?? L["OrderSummary.Discount"])</dt>
                <dd class="os-kv__val os-kv__val--positive">−@Formatting.Currency(Discount)</dd>
            </div>
        }
        <div class="os-kv__row">
            <dt class="os-kv__key">@L["OrderSummary.Shipping"]</dt>
            @if (ShippingCost > 0)
            {
                <dd class="os-kv__val">@Formatting.Currency(ShippingCost)</dd>
            }
            else
            {
                <dd class="os-kv__val os-kv__val--positive shipping-free">@L["OrderSummary.Free"]</dd>
            }
        </div>
        <div class="os-kv__row os-kv__row--total">
            <dt class="os-kv__key">@L["OrderSummary.Total"]</dt>
            <dd class="os-kv__val">@Formatting.Currency(Subtotal - Discount + ShippingCost)</dd>
        </div>
    </dl>

    @if (Actions is not null)
    {
        <div class="os-summary__actions">@Actions</div>
    }
</aside>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public decimal Subtotal { get; set; }
    [Parameter] public decimal Discount { get; set; }
    [Parameter] public decimal ShippingCost { get; set; }
    [Parameter] public string? DiscountLabel { get; set; }
    [Parameter] public bool ShowLineItems { get; set; }
    [Parameter] public IReadOnlyList<CartItemDto> Items { get; set; } = [];

    /// <summary>Offset below the fixed header while sticky.</summary>
    [Parameter] public string StickyTop { get; set; } = "24px";

    [Parameter] public RenderFragment? CouponSlot { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
