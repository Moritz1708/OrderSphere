@page "/returns"
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Returns.PageTitle"]</PageTitle>

<ArticleLayout Eyebrow="@L["Footer.Service"]"
               Title="@L["Returns.Title"]"
               Lede="@L["Returns.Lede"]"
               Numbered="false"
               Sections="_sections" />

@code {
    // Returns.Step1..Step4 in AppStrings.
    private const int StepCount = 4;

    private IReadOnlyList<ArticleSection> _sections = [];

    protected override void OnInitialized() => _sections =
    [
        new("steps", L["Returns.StepsTitle"], Content: Steps),
        new("notes", L["Returns.NotesTitle"], new MarkupString(L["Returns.NotesBody"])),
    ];

    private RenderFragment Steps => @<ol class="os-steps">
        @for (var n = 1; n <= StepCount; n++)
        {
            <li class="os-steps__item">
                <span class="os-steps__num" aria-hidden="true">@n.ToString("00")</span>
                <div>
                    <h3 class="os-steps__title">@L[$"Returns.Step{n}.Title"]</h3>
                    <p class="os-steps__body">@L[$"Returns.Step{n}.Body"]</p>
                </div>
            </li>
        }
    </ol>;
}
