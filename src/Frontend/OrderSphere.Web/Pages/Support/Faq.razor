@page "/faq"
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Faq.PageTitle"]</PageTitle>

<ArticleLayout Eyebrow="@L["Footer.Service"]"
               Title="@L["Faq.Title"]"
               Lede="@L["Faq.Lede"]">
    <MudExpansionPanels MultiExpansion="true" Elevation="0" Gutters="false" Class="os-faq">
        @for (var i = 1; i <= QuestionCount; i++)
        {
            // The panel body renders after the loop has finished; it needs its own copy.
            var n = i;
            <MudExpansionPanel Text="@L[$"Faq.Q{n}"]">
                <p class="os-faq__answer">@L[$"Faq.A{n}"]</p>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>

    <OsCard Surface="OsCard.CardSurface.Sunk" Padding="OsCard.CardPadding.Lg" Class="os-article__cta">
        <div>
            <h2 class="os-article__cta-title">@L["Faq.MoreTitle"]</h2>
            <p class="os-muted">@L["Faq.MoreBody"]</p>
        </div>
        <OsButton Href="/contact" EndIcon="@Icons.Material.Outlined.ArrowForward">@L["Faq.MoreCta"]</OsButton>
    </OsCard>
</ArticleLayout>

@code {
    // Faq.Q1..Q8 / Faq.A1..A8 in AppStrings.
    private const int QuestionCount = 8;
}
