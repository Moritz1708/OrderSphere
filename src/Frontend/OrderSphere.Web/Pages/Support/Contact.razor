@page "/contact"
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Contact.PageTitle"]</PageTitle>

<ArticleLayout Eyebrow="@L["Footer.Service"]"
               Title="@L["Contact.Title"]"
               Lede="@L["Contact.Lede"]">
    <div class="os-contact">
        <OsCard Class="os-contact__card">
            <MudIcon Icon="@Icons.Material.Outlined.Email" Class="os-contact__icon" />
            <h2 class="os-contact__title">@L["Contact.EmailTitle"]</h2>
            <p class="os-muted">@L["Contact.EmailHint"]</p>
            <a class="os-contact__value" href="mailto:support@ordersphere.dev">support@ordersphere.dev</a>
        </OsCard>

        <OsCard Class="os-contact__card">
            <MudIcon Icon="@Icons.Material.Outlined.Phone" Class="os-contact__icon" />
            <h2 class="os-contact__title">@L["Contact.PhoneTitle"]</h2>
            <p class="os-muted">@L["Contact.PhoneHours"]</p>
            <a class="os-contact__value" href="tel:+49123456789">+49 (0) 123 456 789</a>
        </OsCard>

        <OsCard Class="os-contact__card">
            <MudIcon Icon="@Icons.Material.Outlined.LocationOn" Class="os-contact__icon" />
            <h2 class="os-contact__title">@L["Contact.AddressTitle"]</h2>
            <address class="os-contact__value">
                OrderSphere GmbH<br />
                Musterstraße 1<br />
                12345 Musterstadt
            </address>
        </OsCard>
    </div>

    <OsCard Surface="OsCard.CardSurface.Sunk" Padding="OsCard.CardPadding.Lg" Class="os-article__cta">
        <div>
            <h2 class="os-article__cta-title">@L["Contact.FormTitle"]</h2>
            <p class="os-muted">@L["Contact.FormNotice"]</p>
        </div>
        <OsButton Href="mailto:support@ordersphere.dev" StartIcon="@Icons.Material.Outlined.Email">
            @L["Contact.FormCta"]
        </OsButton>
    </OsCard>
</ArticleLayout>
