@page "/search"
@attribute [Authorize]
@inject ICatalogClient Catalog
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Search.PageTitle"]</PageTitle>

<OsPageHeader Eyebrow="@L["Search.HeroEyebrow"]"
              Title="@L["Search.HeroTitle"]"
              Subtitle="@L["Search.HeroSubtitle"]"
              Size="OsDisplay.DisplaySize.D3">
    <OsSearchBar @bind-Value="_queryInput"
                 Size="OsSearchBar.SearchSize.Hero"
                 OnSubmit="OnSearchSubmit"
                 AutoFocus="true"
                 Class="pg-search__bar" />
</OsPageHeader>

<OsSection Padding="OsSection.SectionPadding.Sm" Class="pg-search__results">
    @if (_loading)
    {
        <OsProductCardSkeleton Count="6" />
    }
    else if (string.IsNullOrWhiteSpace(Query))
    {
        <OsEmptyState Icon="@Icons.Material.Outlined.Search"
                      Title="@L["Search.Prompt"]"
                      Body="@L["Search.PromptHint"]" />
    }
    else if (_results.Count == 0)
    {
        <OsEmptyState Icon="@Icons.Material.Outlined.SearchOff"
                      Title="@L["Search.NoResults", Query!]"
                      Body="@L["Search.NoResultsHint"]"
                      ActionText="@L["Cart.ToShop"]"
                      ActionHref="/shop" />
    }
    else
    {
        <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3" Class="mb-6">
            @L["Search.ResultsCount", _totalCount, Query!]
        </OsDisplay>

        <div class="os-product-grid">
            @foreach (var product in _results)
            {
                <ProductCard @key="product.Id"
                             Product="product"
                             ShowCategory="true"
                             OnOpen="OpenDetails"
                             OnAdd="AddToCartAsync" />
            }
        </div>

        @if (_totalPages > 1)
        {
            <div class="os-pager">
                <MudPagination Color="Color.Primary" Count="_totalPages"
                               Selected="_page" SelectedChanged="OnPageChangedAsync" />
            </div>
        }
    }
</OsSection>

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    private string _queryInput = string.Empty;
    private List<ProductDto> _results = [];
    private bool _loading;

    private const int PageSize = 12;
    private int _page = 1;
    private int _totalCount;
    private int _totalPages;

    protected override async Task OnParametersSetAsync()
    {
        _queryInput = Query ?? string.Empty;
        _page = 1;
        await RunSearchAsync();
    }

    private async Task RunSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(Query))
        {
            _results = [];
            _totalCount = 0;
            _totalPages = 0;
            return;
        }

        _loading = true;
        try
        {
            var res = await Catalog.GetProductsAsync(
                new ProductQuery(Page: _page, PageSize: PageSize, Search: Query.Trim()));
            if (!res.IsSuccess)
            {
                Snackbar.ShowApiError(res.Error);
                _results = [];
                _totalCount = 0;
                _totalPages = 0;
                return;
            }

            _results = res.Value!.Items.ToList();
            _totalCount = res.Value.TotalCount;
            _totalPages = res.Value.TotalPages;
        }
        catch (Exception ex)
        {
            Snackbar.ShowError(L["Search.Error", ex.Message]);
            _results = [];
            _totalCount = 0;
            _totalPages = 0;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnPageChangedAsync(int page)
    {
        _page = page;
        await RunSearchAsync();
    }

    private void OpenDetails(ProductDto product)
        => Navigation.NavigateTo($"/shop/{Uri.EscapeDataString(product.CategoryName)}/{Uri.EscapeDataString(product.Slug)}");

    // The old page passed an empty callback here, so the add button did nothing.
    private Task AddToCartAsync(ProductDto product) => AddToCartDialog.ShowAsync(Dialogs, product);

    private void OnSearchSubmit(string term)
    {
        var url = string.IsNullOrEmpty(term) ? "/search" : $"/search?q={Uri.EscapeDataString(term)}";
        Navigation.NavigateTo(url);
    }
}
