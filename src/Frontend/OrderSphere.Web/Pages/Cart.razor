@page "/cart"
@attribute [Authorize]
@implements IDisposable
@inject IOrderingClient Ordering
@inject CartState CartState
@inject ISnackbar Snackbar
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Cart.PageTitle"]</PageTitle>

<OsPageHeader Title="@L["Cart.HeroTitle"]" Subtitle="@L["Cart.HeroSubtitle", _items.Count]" />

<OsSection Padding="OsSection.SectionPadding.Sm">
    @if (_loading)
    {
        <OsListSkeleton Rows="3" />
    }
    else if (_items.Count == 0)
    {
        <OsEmptyState Icon="@Icons.Material.Outlined.ShoppingCart"
                      Title="@L["Cart.EmptyHeading"]"
                      Body="@L["Cart.AddProductsHint"]"
                      ActionText="@L["Cart.DiscoverProducts"]"
                      ActionHref="/shop"
                      ActionIcon="@Icons.Material.Outlined.Storefront" />
    }
    else
    {
        <MudGrid Spacing="4">
            <MudItem xs="12" lg="8">
                <div class="os-rows">
                    @foreach (var item in _items)
                    {
                        <div class="os-row pg-cart__row" @key="item.ProductId">
                            <OsProductImage Seed="item.ProductId" Name="@item.ProductName" Ratio="1/1" Class="pg-cart__thumb" />

                            <div class="os-row__main">
                                <span class="os-row__title">@item.ProductName</span>
                                <span class="os-row__meta os-num">@Formatting.Currency(item.Price) @L["Cart.PerUnitSuffix"]</span>
                                <OsQuantityStepper Value="item.Quantity"
                                                   ValueChanged="newValue => HandleQuantityChange(item, newValue)"
                                                   Min="1"
                                                   Disabled="_busy"
                                                   Size="OsQuantityStepper.StepperSize.Sm"
                                                   Label="@item.ProductName"
                                                   Class="mt-2" />
                            </div>

                            <div class="os-row__end pg-cart__end">
                                <OsPrice Value="item.Price * item.Quantity" Size="OsPrice.PriceSize.Lg" />
                                <OsIconButton Icon="@Icons.Material.Outlined.Close"
                                              Size="OsIconButton.IconButtonSize.Sm"
                                              AriaLabel="@L["Cart.RemoveAria", item.ProductName]"
                                              Disabled="_busy"
                                              OnClick="@(() => RemoveItemAsync(item))" />
                            </div>
                        </div>
                    }
                </div>
            </MudItem>

            <MudItem xs="12" lg="4">
                <OrderSummary Title="@L["Cart.Summary"]" Subtotal="Subtotal">
                    <Actions>
                        <OsButton Href="/checkout"
                                  Size="OsButton.ButtonSize.Lg"
                                  FullWidth="true"
                                  EndIcon="@Icons.Material.Outlined.ArrowForward">
                            @L["Cart.ToCheckout"]
                        </OsButton>
                        <OsButton Href="/shop" Variant="OsButton.ButtonVariant.Ghost" FullWidth="true">
                            @L["Cart.ContinueShopping"]
                        </OsButton>
                    </Actions>
                </OrderSummary>
            </MudItem>
        </MudGrid>
    }
</OsSection>

@code {
    private List<CartItemDto> _items = [];
    private bool _loading = true;
    private bool _busy;

    private decimal Subtotal => _items.Sum(x => x.Price * x.Quantity);

    protected override void OnInitialized()
    {
        CartState.OnChange += OnCartChanged;
        SyncFromCartState();
        _loading = false;
    }

    private void OnCartChanged()
    {
        SyncFromCartState();
        InvokeAsync(StateHasChanged);
    }

    private void SyncFromCartState() => _items = CartState.Cart?.Items?.ToList() ?? [];

    private async Task HandleQuantityChange(CartItemDto item, int newValue)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var result = newValue > item.Quantity
                ? await Ordering.AddToCartAsync(item.ProductId, 1)
                : await Ordering.DecreaseCartItemAsync(item.ProductId);

            if (result.IsSuccess)
                await CartState.RefreshAsync();
            else
                Snackbar.ShowApiError(result.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveItemAsync(CartItemDto item)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var result = await Ordering.RemoveFromCartAsync(item.ProductId);
            if (result.IsSuccess)
            {
                await CartState.RefreshAsync();
                Snackbar.ShowInfo(L["Cart.ItemRemoved", item.ProductName]);
            }
            else
            {
                Snackbar.ShowApiError(result.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose() => CartState.OnChange -= OnCartChanged;
}
