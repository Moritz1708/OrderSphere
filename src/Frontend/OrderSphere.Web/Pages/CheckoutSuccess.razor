@page "/checkout/success"
@attribute [Authorize]
@inject IOrderingClient Ordering
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["CheckoutSuccess.PageTitle"]</PageTitle>

<OsSection Width="OsSection.SectionWidth.Narrow" Padding="OsSection.SectionPadding.Lg" Class="pg-success">
    <span class="pg-success__mark" aria-hidden="true">
        <MudIcon Icon="@Icons.Material.Outlined.Check" />
    </span>

    <OsDisplay As="h1" Size="OsDisplay.DisplaySize.D1">@L["CheckoutSuccess.Title"]</OsDisplay>
    <p class="pg-success__body">@L["CheckoutSuccess.Body"]</p>

    @if (_totalAmount.HasValue)
    {
        <p class="pg-success__total os-mono">@L["CheckoutSuccess.Total", Formatting.Currency(_totalAmount.Value)]</p>
    }

    @if (_order is not null)
    {
        <OsCard Surface="OsCard.CardSurface.Sunk" Class="pg-success__order">
            <OsEyebrow Text="@L["CheckoutSuccess.OrderNumber"]" Tone="OsEyebrow.EyebrowTone.Muted" Rule="false" />
            <span class="pg-success__number os-mono">#@_order.Id.ToString("N")[..8].ToUpperInvariant()</span>
        </OsCard>
    }
    else if (_polling)
    {
        <OsSkeletonGroup Class="pg-success__order">
            <OsSkeleton Width="140px" Height="10px" />
            <OsSkeleton Width="200px" Height="28px" Class="mt-2" />
        </OsSkeletonGroup>
    }

    <div class="pg-success__actions">
        <OsButton Href="/account/orders" Size="OsButton.ButtonSize.Lg">@L["Account.MyOrders"]</OsButton>
        <OsButton Href="/shop" Variant="OsButton.ButtonVariant.Secondary" Size="OsButton.ButtonSize.Lg">
            @L["CheckoutSuccess.ContinueShopping"]
        </OsButton>
    </div>
</OsSection>

@code {
    [SupplyParameterFromQuery] private Guid? CorrelationId { get; set; }
    [SupplyParameterFromQuery] private string? Total { get; set; }

    private OrderDto? _order;
    private decimal? _totalAmount;
    private bool _polling;

    protected override async Task OnInitializedAsync()
    {
        if (decimal.TryParse(Total, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var parsed))
        {
            _totalAmount = parsed;
        }

        if (CorrelationId is null) return;

        // Poll for the order (Service Bus processing may take a moment).
        // Ownership is enforced server-side via the JWT token.
        _polling = true;
        try
        {
            for (var i = 0; i < 6; i++)
            {
                _order = await Ordering.GetOrderByCorrelationIdAsync(CorrelationId.Value);
                if (_order is not null) break;
                await Task.Delay(2000);
            }
        }
        finally
        {
            _polling = false;
        }
    }
}
