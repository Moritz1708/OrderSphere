@page "/checkout"
@attribute [Authorize]
@inject IOrderingClient Ordering
@inject CartState CartState
@inject ISnackbar Snackbar
@inject IMotionService Motion
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Checkout.PageTitle"]</PageTitle>

<OsPageHeader Eyebrow="@L["Checkout.Eyebrow"]"
              Title="@L["Checkout.Title"]"
              Subtitle="@L["Checkout.Subtitle"]"
              Size="OsDisplay.DisplaySize.D3"
              Padding="OsPageHeader.HeaderPadding.Sm" />

<OsSection Padding="OsSection.SectionPadding.Sm">
    <div class="pg-checkout">
        <div class="pg-checkout__steps">
            @* 01 — where it goes *@
            <section class="pg-step" aria-labelledby="step-address">
                <span class="pg-step__num os-mono" aria-hidden="true">01</span>
                <div class="pg-step__body">
                    <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3" id="step-address">@L["Address.Title"]</OsDisplay>
                    <p class="pg-step__hint">@L["Checkout.AddressHint"]</p>
                    <AddressForm @ref="_addressForm" Model="_model.Address" ShowEmail="true" />
                </div>
            </section>

            @* 02 — how it is paid *@
            <section class="pg-step" aria-labelledby="step-payment">
                <span class="pg-step__num os-mono" aria-hidden="true">02</span>
                <div class="pg-step__body">
                    <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3" id="step-payment">@L["Payment.Title"]</OsDisplay>
                    <p class="pg-step__hint">@L["Checkout.PaymentHint"]</p>
                    <CheckoutPaymentForm Model="_model" />
                </div>
            </section>

            @* 03 — what is being ordered *@
            <section class="pg-step" aria-labelledby="step-review">
                <span class="pg-step__num os-mono" aria-hidden="true">03</span>
                <div class="pg-step__body">
                    <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3" id="step-review">@L["Checkout.ReviewTitle"]</OsDisplay>
                    <p class="pg-step__hint">@L["Checkout.ReviewHint"]</p>

                    <dl class="os-kv pg-checkout__review">
                        <div class="os-kv__row">
                            <dt class="os-kv__key">@L["Checkout.ReviewItems"]</dt>
                            <dd class="os-kv__val os-num">@_cartItems.Sum(i => i.Quantity)</dd>
                        </div>
                        <div class="os-kv__row">
                            <dt class="os-kv__key">@L["Checkout.ReviewShipTo"]</dt>
                            <dd class="os-kv__val">@ShipTo</dd>
                        </div>
                        <div class="os-kv__row">
                            <dt class="os-kv__key">@L["Payment.Title"]</dt>
                            <dd class="os-kv__val">@L[PaymentLabelKey]</dd>
                        </div>
                    </dl>

                    <p class="pg-step__note">@L["Checkout.TermsNote"]</p>
                </div>
            </section>
        </div>

        <div class="pg-checkout__aside">
            <OrderSummary Title="@L["Checkout.Summary"]"
                          ShowLineItems="true"
                          Items="_cartItems"
                          Subtotal="Subtotal"
                          Discount="_discount"
                          ShippingCost="Shipping">
                <CouponSlot>
                    @if (string.IsNullOrEmpty(_appliedCoupon))
                    {
                        <div class="os-coupon">
                            <MudTextField T="string" @bind-Value="_couponInput"
                                          Placeholder="@L["Checkout.CouponPlaceholder"]"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Class="os-coupon__input" />
                            <OsButton Variant="OsButton.ButtonVariant.Secondary"
                                      OnClick="ApplyCouponAsync"
                                      Loading="_couponValidating">
                                @L["Checkout.CouponApply"]
                            </OsButton>
                        </div>
                    }
                    else
                    {
                        <div class="os-coupon os-coupon--applied">
                            <OsStatusChip Tone="StatusTone.Success" Text="@_appliedCoupon" Dot="true" />
                            <OsButton Variant="OsButton.ButtonVariant.Ghost"
                                      Size="OsButton.ButtonSize.Sm"
                                      OnClick="RemoveCoupon">
                                @L["Checkout.CouponRemove"]
                            </OsButton>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_couponMessage))
                    {
                        <p class="os-coupon__message">@_couponMessage</p>
                    }
                </CouponSlot>
                <Actions>
                    <OsButton FullWidth="true"
                              Size="OsButton.ButtonSize.Lg"
                              Loading="_submitting"
                              Disabled="@(_cartItems.Count == 0)"
                              OnClick="SubmitAsync"
                              Class="mt-4">
                        @L["Checkout.Submit"]
                    </OsButton>
                </Actions>
            </OrderSummary>
        </div>
    </div>
</OsSection>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private AddressForm _addressForm = default!;
    private List<CartItemDto> _cartItems = [];
    private bool _submitting;

    // Generated once per page visit. Stable across Polly retries; changes on navigation/refresh.
    private Guid _idempotencyKey = Guid.CreateVersion7();

    private readonly CheckoutFormModel _model = new();

    // Coupon state. The discount shown here is a preview; the worker recomputes it authoritatively.
    private string _couponInput = string.Empty;
    private string? _appliedCoupon;
    private decimal _discount;
    private string? _couponMessage;
    private bool _couponValidating;

    private decimal Subtotal => _cartItems.Sum(i => i.Quantity * i.Price);

    // Estimate; the worker recomputes shipping authoritatively from the (pre-discount) subtotal.
    private decimal Shipping => ShippingEstimate.For(Subtotal);

    private string PaymentLabelKey => _model.PaymentMethod switch
    {
        1 => "Payment.PayPal",
        2 => "Payment.Invoice",
        _ => "Payment.CreditCard",
    };

    private string ShipTo
    {
        get
        {
            var a = _model.Address;
            var name = $"{a.FirstName} {a.LastName}".Trim();
            var place = string.Join(" ", new[] { a.PostalCode, a.City }.Where(s => !string.IsNullOrWhiteSpace(s)));
            var parts = new[] { name, a.Street, place }.Where(s => !string.IsNullOrWhiteSpace(s));
            return parts.Any() ? string.Join(", ", parts) : L["Checkout.ReviewShipToPending"];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await (AuthState ?? Task.FromResult(new AuthenticationState(new System.Security.Claims.ClaimsPrincipal())));
        _model.Address.Email = state.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? string.Empty;

        _cartItems = CartState.Cart?.Items ?? [];
        if (!_cartItems.Any())
        {
            var cart = await Ordering.GetCartAsync();
            if (cart.IsSuccess)
                _cartItems = cart.Value!.Items;
        }
    }

    private async Task ApplyCouponAsync()
    {
        var code = _couponInput?.Trim() ?? string.Empty;
        if (string.IsNullOrEmpty(code)) return;

        _couponValidating = true;
        try
        {
            var result = await Ordering.ValidateCouponAsync(code, Subtotal);
            if (!result.IsSuccess)
            {
                _couponMessage = result.Error?.Message;
                _appliedCoupon = null;
                _discount = 0;
                return;
            }

            var dto = result.Value!;
            _couponMessage = dto.Message;
            _appliedCoupon = dto.IsValid ? code : null;
            _discount = dto.IsValid ? dto.DiscountAmount : 0;
        }
        finally
        {
            _couponValidating = false;
        }
    }

    private void RemoveCoupon()
    {
        _appliedCoupon = null;
        _discount = 0;
        _couponMessage = null;
        _couponInput = string.Empty;
    }

    private async Task SubmitAsync()
    {
        // Field-level errors come from the form itself; a toast would only repeat them.
        // The summary can sit far from the address step, so move focus to the first problem.
        if (!await _addressForm.ValidateAsync())
        {
            await Motion.FocusFirstInvalidAsync();
            return;
        }

        _submitting = true;
        try
        {
            // Identity fields (CustomerId, CustomerEmail, CustomerName) are derived
            // from the JWT token server-side and not included in the request body.
            var request = new CheckoutRequest(_model.Address.ToCheckoutAddress(), _model.PaymentMethod, _appliedCoupon);

            var result = await Ordering.CheckoutAsync(request, _idempotencyKey);
            if (!result.IsSuccess)
            {
                Snackbar.ShowApiError(result.Error);
                return;
            }

            await CartState.RefreshAsync();
            var total = Subtotal - _discount + Shipping;
            Navigation.NavigateTo(
                $"/checkout/success?correlationId={result.Value}&total={total.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)}");
        }
        finally
        {
            _submitting = false;
        }
    }
}
