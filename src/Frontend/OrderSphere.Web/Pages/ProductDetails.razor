@page "/shop/{Category}/{Slug}"
@page "/p/{Slug}"
@inject ICatalogClient Catalog
@inject IOrderingClient Ordering
@inject CartState CartState
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L

<PageTitle>@(_product?.Name ?? L["ProductDetails.PageFallback"]) – OrderSphere</PageTitle>

@if (_loading)
{
    <OsSection Padding="OsSection.SectionPadding.Sm">
        <OsDetailSkeleton />
    </OsSection>
}
else if (_product is null)
{
    <OsSection Width="OsSection.SectionWidth.Narrow">
        <OsEmptyState Icon="@Icons.Material.Outlined.SearchOff"
                      Title="@L["ProductDetails.NotFound"]"
                      ActionText="@L["ProductDetails.BackToShop"]"
                      ActionHref="/shop" />
    </OsSection>
}
else
{
    <OsSection Padding="OsSection.SectionPadding.Sm">
        <OsBreadcrumbs Items="Crumbs" Class="mb-6" />

        <div class="pg-pdp">
            <div class="pg-pdp__media">
                <OsProductImage Product="_product" Ratio="4/5" Eager="true" />
            </div>

            <div class="pg-pdp__buy">
                <OsEyebrow Text="@_product.CategoryName" />
                <OsDisplay As="h1" Size="OsDisplay.DisplaySize.D2" Class="mt-2">@_product.Name</OsDisplay>

                @if (_product.ReviewCount > 0)
                {
                    <StarRating Value="_product.AverageRating" Count="_product.ReviewCount" />
                }

                <OsPrice Value="_product.Price" Size="OsPrice.PriceSize.Display" Class="mt-3" />

                <OsStatusChip Tone="StatusPresentation.StockTone(_product.Stock)"
                              Text="@L[StatusPresentation.StockLabelKey(_product.Stock), _product.Stock]"
                              Dot="true" />

                <p class="pg-pdp__desc">@_product.Description</p>

                <div class="pg-pdp__cta">
                    <AuthorizeView Context="auth">
                    <Authorized>
                    <OsQuantityStepper @bind-Value="_quantity"
                                       Min="1"
                                       Max="@Math.Max(1, _product.Stock)"
                                       Disabled="@(_product.Stock == 0)"
                                       Label="@_product.Name" />
                    <OsButton Size="OsButton.ButtonSize.Lg"
                              Loading="_adding"
                              Disabled="@(_product.Stock == 0)"
                              StartIcon="@Icons.Material.Outlined.AddShoppingCart"
                              OnClick="AddToCartAsync">
                        @L["Common.AddToCart"]
                    </OsButton>
                    </Authorized>
                    <NotAuthorized>
                    <OsButton Size="OsButton.ButtonSize.Lg"
                              StartIcon="@Icons.Material.Outlined.Login"
                              OnClick="() => LoginRedirect.Go(Navigation)">
                        @L["Auth.SignInToBuy"]
                    </OsButton>
                    </NotAuthorized>
                    </AuthorizeView>
                </div>

                <dl class="os-kv pg-pdp__meta">
                    <div class="os-kv__row">
                        <dt class="os-kv__key">@L["ProductDetails.Sku"]</dt>
                        <dd class="os-kv__val os-mono">@_product.SKU</dd>
                    </div>
                    <div class="os-kv__row">
                        <dt class="os-kv__key">@L["ProductDetails.Category"]</dt>
                        <dd class="os-kv__val"><a href="@($"/shop/category/{Uri.EscapeDataString(_product.CategoryName)}")">@_product.CategoryName</a></dd>
                    </div>
                    <div class="os-kv__row">
                        <dt class="os-kv__key">@L["ProductDetails.Availability"]</dt>
                        <dd class="os-kv__val">@L[StatusPresentation.StockLabelKey(_product.Stock), _product.Stock]</dd>
                    </div>
                </dl>
            </div>
        </div>
    </OsSection>

    <OsSection Tone="OsSection.SectionTone.Sunk">
        <div class="pg-pdp__reviews">
            <div class="pg-pdp__review-form">
                <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3">@L["Reviews.WriteTitle"]</OsDisplay>
                <AuthorizeView Context="auth">
                <NotAuthorized>
                <OsEmptyState Icon="@Icons.Material.Outlined.Login"
                              Title="@L["Reviews.SignInHint"]"
                              ActionText="@L["Auth.SignIn"]"
                              OnAction="() => LoginRedirect.Go(Navigation)"
                              Compact="true" />
                </NotAuthorized>
                <Authorized>
                <p class="os-muted">@L["Reviews.WriteHint"]</p>

                <div class="pg-pdp__rating">
                    <span class="os-eyebrow os-eyebrow--muted os-eyebrow--no-rule">@L["Reviews.RatingLabel"]</span>
                    <MudRating @bind-SelectedValue="_newRating" MaxValue="5" />
                </div>
                <MudTextField @bind-Value="_newTitle" Label="@L["Reviews.TitleLabel"]"
                              Variant="Variant.Outlined" ShrinkLabel="true" MaxLength="150" Immediate="true" />
                <MudTextField @bind-Value="_newBody" Label="@L["Reviews.BodyLabel"]"
                              Variant="Variant.Outlined" ShrinkLabel="true" Lines="4" MaxLength="2000" Immediate="true" />
                <OsButton Loading="_submitting"
                          Disabled="@(_newRating == 0 || string.IsNullOrWhiteSpace(_newTitle) || string.IsNullOrWhiteSpace(_newBody))"
                          OnClick="SubmitReviewAsync">
                    @L["Reviews.Submit"]
                </OsButton>
                </Authorized>
                </AuthorizeView>
            </div>

            <div class="pg-pdp__review-list">
                <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3">
                    @L["Reviews.ListTitle"] <span class="os-num os-muted">(@_reviews.Count)</span>
                </OsDisplay>

                @if (_reviewsError is not null)
                {
                    <OsErrorState Message="@_reviewsError" OnRetry="LoadReviewsAsync" />
                }
                else if (_reviews.Count == 0)
                {
                    <OsEmptyState Icon="@Icons.Material.Outlined.RateReview" Title="@L["Reviews.Empty"]" Compact="true" />
                }
                else
                {
                    <div class="os-rows">
                        @foreach (var review in _reviews)
                        {
                            <article class="os-row pg-review" @key="review.Id">
                                <div class="os-row__main">
                                    <div class="pg-review__head">
                                        <StarRating Value="review.Rating" ShowCount="false" />
                                        @if (review.IsVerifiedPurchase)
                                        {
                                            <OsStatusChip Tone="StatusTone.Success" Text="@L["Reviews.VerifiedPurchase"]" Size="OsStatusChip.ChipSize.Sm" />
                                        }
                                    </div>
                                    <strong class="pg-review__title">@review.Title</strong>
                                    <p class="pg-review__body">@review.Body</p>
                                    <span class="os-row__meta os-mono">@Formatting.Date(review.CreatedAt.ToLocalTime())</span>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </div>
    </OsSection>
}

@code {
    [Parameter] public string? Category { get; set; }
    [Parameter] public string Slug { get; set; } = string.Empty;

    private ProductDto? _product;
    private bool _loading = true;
    private bool _adding;
    private int _quantity = 1;

    private List<ReviewDto> _reviews = [];
    private string? _reviewsError;
    private int _newRating;
    private string _newTitle = string.Empty;
    private string _newBody = string.Empty;
    private bool _submitting;

    private IReadOnlyList<OsCrumb> Crumbs => _product is null
        ? []
        :
        [
            new(L["Nav.Shop"], "/shop"),
            new(_product.CategoryName, $"/shop/category/{Uri.EscapeDataString(_product.CategoryName)}"),
            new(_product.Name),
        ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var res = await Catalog.GetProductBySlugAsync(Slug);
            _product = res.Value;
            if (!res.IsSuccess && res.Error?.Kind != ApiErrorKind.NotFound)
                Snackbar.ShowApiError(res.Error);

            if (_product is not null)
                await LoadReviewsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.ShowError(L["ProductDetails.Error", ex.Message]);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadReviewsAsync()
    {
        if (_product is null) return;
        _reviewsError = null;
        try
        {
            var res = await Catalog.GetReviewsAsync(_product.Id);
            if (res.IsSuccess)
                _reviews = res.Value ?? [];
            else
                _reviewsError = res.Error?.Message ?? L["Common.LoadError"];
        }
        catch (Exception ex)
        {
            _reviewsError = L["ProductDetails.Error", ex.Message];
        }
    }

    private async Task SubmitReviewAsync()
    {
        if (_product is null) return;
        _submitting = true;
        try
        {
            var result = await Catalog.CreateReviewAsync(
                _product.Id, new CreateReviewRequest(_newRating, _newTitle.Trim(), _newBody.Trim()));

            if (!result.IsSuccess)
            {
                Snackbar.ShowApiError(result.Error);
                return;
            }

            Snackbar.ShowSuccess(L["Reviews.SubmitSuccess"]);
            _newRating = 0;
            _newTitle = string.Empty;
            _newBody = string.Empty;

            // Refresh reviews and the product so the average rating updates.
            await LoadReviewsAsync();
            var refreshed = await Catalog.GetProductBySlugAsync(Slug);
            if (refreshed.IsSuccess)
                _product = refreshed.Value;
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task AddToCartAsync()
    {
        if (_product is null) return;
        _adding = true;
        try
        {
            var result = await Ordering.AddToCartAsync(_product.Id, _quantity);
            if (!result.IsSuccess)
            {
                Snackbar.ShowApiError(result.Error);
                return;
            }

            Snackbar.ShowSuccess(L["Common.AddedToCart", _quantity, _product.Name]);
            await CartState.RefreshAsync();
        }
        finally
        {
            _adding = false;
        }
    }
}
