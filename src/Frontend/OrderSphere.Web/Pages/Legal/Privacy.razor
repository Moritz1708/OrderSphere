@page "/privacy"
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Privacy.PageTitle"]</PageTitle>

<ArticleLayout Eyebrow="@L["Footer.Legal"]"
               Title="@L["Privacy.Title"]"
               Lede="@L["Privacy.Lede"]"
               Notice="@L["Article.PlaceholderNotice"]"
               Sections="_sections" />

@code {
    private IReadOnlyList<ArticleSection> _sections = [];

    protected override void OnInitialized() => _sections =
    [
        Section("controller", 1),
        Section("collection", 2),
        Section("purposes", 3),
        Section("cookies", 4),
        Section("rights", 5),
        Section("retention", 6),
    ];

    private ArticleSection Section(string id, int n) =>
        new(id, L[$"Privacy.S{n}.Title"], new MarkupString(L[$"Privacy.S{n}.Body"]));
}
