@page "/imprint"
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Imprint.PageTitle"]</PageTitle>

<ArticleLayout Eyebrow="@L["Footer.Legal"]"
               Title="@L["Imprint.Title"]"
               Lede="@L["Imprint.Lede"]"
               Notice="@L["Article.PlaceholderNotice"]"
               Numbered="false"
               Sections="_sections" />

@code {
    private IReadOnlyList<ArticleSection> _sections = [];

    protected override void OnInitialized() => _sections =
    [
        Section("provider", 1),
        Section("representation", 2),
        Section("contact", 3),
        Section("register", 4),
        Section("vat", 5),
        Section("editorial", 6),
    ];

    private ArticleSection Section(string id, int n) =>
        new(id, L[$"Imprint.S{n}.Title"], new MarkupString(L[$"Imprint.S{n}.Body"]));
}
