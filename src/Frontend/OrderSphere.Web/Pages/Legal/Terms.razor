@page "/terms"
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Terms.PageTitle"]</PageTitle>

<ArticleLayout Eyebrow="@L["Footer.Legal"]"
               Title="@L["Terms.Title"]"
               Lede="@L["Terms.Lede"]"
               Notice="@L["Article.PlaceholderNotice"]"
               NumberFormat="§ {0}"
               Sections="_sections" />

@code {
    private IReadOnlyList<ArticleSection> _sections = [];

    protected override void OnInitialized() => _sections =
    [
        Section("scope", 1),
        Section("contract", 2),
        Section("prices", 3),
        Section("delivery", 4),
        Section("payment", 5),
        Section("withdrawal", 6),
        Section("warranty", 7),
        Section("final", 8),
    ];

    private ArticleSection Section(string id, int n) =>
        new(id, L[$"Terms.S{n}.Title"], new MarkupString(L[$"Terms.S{n}.Body"]));
}
