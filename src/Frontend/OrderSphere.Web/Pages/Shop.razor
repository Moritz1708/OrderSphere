@page "/shop"
@page "/shop/category/{Category}"
@inject ICatalogClient Catalog
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Shop.PageTitle"]</PageTitle>

<OsPageHeader Eyebrow="@L["Common.AllProducts"]"
              Title="@(Category ?? L["Shop.HeroTitle"])"
              Subtitle="@L["Shop.HeroSubtitle"]"
              Breadcrumbs="Crumbs">
    <Actions>
        @if (!_loading)
        {
            <span class="os-mono os-muted"><span class="os-num">@_totalCount</span> @L["Shop.ProductsLabel"]</span>
        }
    </Actions>
</OsPageHeader>

<OsSection Padding="OsSection.SectionPadding.Sm">
    <OsCard Class="pg-shop__filters mb-6">
        <MudGrid Spacing="2" Class="align-center">
            <MudItem xs="12" md="4">
                <MudTextField T="string" @bind-Value="_search"
                              Placeholder="@L["Shop.SearchPlaceholder"]"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              OnKeyDown="OnSearchKeyDown" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudSelect T="string" @bind-Value="_categoryFilter" @bind-Value:after="ResetAndReloadAsync"
                           Label="@L["Shop.CategoryFilter"]" Clearable="true" ShrinkLabel="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var c in _categories)
                    {
                        <MudSelectItem Value="@c.Name">@c.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudSelect T="string" @bind-Value="_sort" @bind-Value:after="ResetAndReloadAsync"
                           Label="@L["Shop.SortLabel"]" ShrinkLabel="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("name_asc")">@L["Shop.SortNameAsc"]</MudSelectItem>
                    <MudSelectItem Value="@("name_desc")">@L["Shop.SortNameDesc"]</MudSelectItem>
                    <MudSelectItem Value="@("price_asc")">@L["Shop.SortPriceAsc"]</MudSelectItem>
                    <MudSelectItem Value="@("price_desc")">@L["Shop.SortPriceDesc"]</MudSelectItem>
                    <MudSelectItem Value="@("newest")">@L["Shop.SortNewest"]</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <OsButton FullWidth="true" OnClick="ApplyAsync">@L["Shop.ApplyFilter"]</OsButton>
            </MudItem>

            <MudItem xs="6" md="3">
                <MudNumericField T="decimal?" @bind-Value="_minPrice" Label="@L["Shop.MinPrice"]" ShrinkLabel="true"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" HideSpinButtons="true" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudNumericField T="decimal?" @bind-Value="_maxPrice" Label="@L["Shop.MaxPrice"]" ShrinkLabel="true"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" HideSpinButtons="true" />
            </MudItem>
            <MudItem xs="12" md="2">
                <OsButton FullWidth="true" Variant="OsButton.ButtonVariant.Ghost" OnClick="ResetFiltersAsync">
                    @L["Shop.ResetFilter"]
                </OsButton>
            </MudItem>
        </MudGrid>
    </OsCard>

    @if (_loading)
    {
        <OsProductCardSkeleton Count="6" />
    }
    else if (_products.Count == 0)
    {
        <OsEmptyState Icon="@Icons.Material.Outlined.Inventory2"
                      Title="@L["Shop.NoProducts"]"
                      Body="@L["Shop.NoProductsHint"]"
                      ActionText="@L["Shop.ResetFilter"]"
                      OnAction="ResetFiltersAsync" />
    }
    else
    {
        <div class="os-product-grid">
            @foreach (var product in _products)
            {
                <ProductCard @key="product.Id"
                             Product="product"
                             ShowCategory="true"
                             OnOpen="OpenDetails"
                             OnAdd="AddToCartAsync" />
            }
        </div>

        @if (_totalPages > 1)
        {
            <div class="os-pager">
                <MudPagination Color="Color.Primary" Count="_totalPages"
                               Selected="_page" SelectedChanged="OnPageChangedAsync" />
            </div>
        }
    }
</OsSection>

@code {
    [Parameter] public string? Category { get; set; }

    private List<ProductDto> _products = [];
    private List<CategoryDto> _categories = [];
    private bool _loading = true;

    private const int PageSize = 12;
    private int _page = 1;
    private int _totalCount;
    private int _totalPages;

    private string _search = string.Empty;
    private string? _categoryFilter;
    private decimal? _minPrice;
    private decimal? _maxPrice;
    private string _sort = "name_asc";

    private string? _lastCategoryRoute;

    private IReadOnlyList<OsCrumb>? Crumbs => Category is null
        ? null
        : [new(L["Nav.Shop"], "/shop"), new(Category)];

    protected override async Task OnInitializedAsync()
    {
        var cats = await Catalog.GetCategoriesAsync();
        if (cats.IsSuccess)
            _categories = cats.Value!.Items.ToList();

        _categoryFilter = Category;
        _lastCategoryRoute = Category;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // React to navigation between /shop and /shop/category/{Category}.
        if (_lastCategoryRoute != Category)
        {
            _lastCategoryRoute = Category;
            _categoryFilter = Category;
            _page = 1;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var (by, dir) = MapSort();
            var query = new ProductQuery(
                Page: _page,
                PageSize: PageSize,
                Search: string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
                Category: string.IsNullOrWhiteSpace(_categoryFilter) ? null : _categoryFilter,
                MinPrice: _minPrice,
                MaxPrice: _maxPrice,
                SortBy: by,
                SortDir: dir);

            var res = await Catalog.GetProductsAsync(query);
            if (res.IsSuccess)
            {
                _products = res.Value!.Items.ToList();
                _totalCount = res.Value.TotalCount;
                _totalPages = res.Value.TotalPages;
            }
            else
            {
                Snackbar.ShowApiError(res.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.ShowError(L["Shop.LoadError", ex.Message]);
        }
        finally
        {
            _loading = false;
        }
    }

    private (string by, string dir) MapSort() => _sort switch
    {
        "name_desc" => ("name", "desc"),
        "price_asc" => ("price", "asc"),
        "price_desc" => ("price", "desc"),
        "newest" => ("newest", "desc"),
        _ => ("name", "asc"),
    };

    private async Task ResetAndReloadAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private Task ApplyAsync() => ResetAndReloadAsync();

    private async Task ResetFiltersAsync()
    {
        _search = string.Empty;
        _categoryFilter = Category;
        _minPrice = null;
        _maxPrice = null;
        _sort = "name_asc";
        _page = 1;
        await LoadAsync();
    }

    private async Task OnPageChangedAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            _ = ApplyAsync();
    }

    private void OpenDetails(ProductDto product)
        => Navigation.NavigateTo($"/shop/{Uri.EscapeDataString(product.CategoryName)}/{Uri.EscapeDataString(product.Slug)}");

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private async Task AddToCartAsync(ProductDto product)
    {
        if (!await LoginRedirect.EnsureSignedInAsync(AuthState, Navigation))
            return;

        await AddToCartDialog.ShowAsync(Dialogs, product);
    }
}
