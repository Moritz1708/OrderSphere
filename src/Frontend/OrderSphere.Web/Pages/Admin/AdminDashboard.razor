@page "/admin"
@inject IAdminOrderingClient AdminOrdering
@inject IAdminCatalogClient AdminCatalog
@inject ISnackbar Snackbar
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Admin.Dashboard.PageTitle"]</PageTitle>

<OsPageHeader Eyebrow="@L["Admin.Nav.Section"]"
              Title="@L["Admin.Dashboard.Title"]"
              Subtitle="@L["Admin.Dashboard.Subtitle"]"
              Size="OsDisplay.DisplaySize.D3"
              Padding="OsPageHeader.HeaderPadding.Sm" />

<OsSection Padding="OsSection.SectionPadding.Sm" Width="OsSection.SectionWidth.Wide">
    @if (_loading)
    {
        <OsSkeletonGroup Class="pg-admin__stats">
            @foreach (var _ in Enumerable.Range(0, 4))
            {
                <OsSkeleton Variant="OsSkeleton.SkeletonVariant.Rect" Height="140px" />
            }
        </OsSkeletonGroup>
    }
    else if (_stats is null)
    {
        <OsErrorState Message="@L["Common.LoadError", "–"]" OnRetry="LoadAsync" />
    }
    else
    {
        <OsRevealGroup Class="pg-admin__stats">
            <OsStat Label="@L["Admin.Dashboard.TotalOrders"]"
                    Value="_stats.TotalOrders"
                    Icon="@Icons.Material.Outlined.Receipt"
                    Delta="@L["Admin.Dashboard.OrdersToday", _stats.OrdersToday]"
                    Href="/admin/orders" />
            <OsStat Label="@L["Admin.Dashboard.TotalRevenue"]"
                    Value="_stats.TotalRevenue"
                    Format="Formatting.Currency"
                    Icon="@Icons.Material.Outlined.Euro"
                    Delta="@($"{Formatting.Currency(_stats.RevenueToday)} {L["Admin.Dashboard.OrdersToday", ""]}")"
                    DeltaTone="StatusTone.Success" />
            <OsStat Label="@L["Admin.Dashboard.PendingShipments"]"
                    Value="_stats.PendingShipments"
                    Icon="@Icons.Material.Outlined.LocalShipping"
                    DeltaTone="StatusTone.Warning" />
            <OsStat Label="@L["Admin.Dashboard.LowStock"]"
                    Value="_lowStockCount"
                    Icon="@Icons.Material.Outlined.Warning"
                    Delta="@L["Admin.Dashboard.LowStockOf", _totalProducts]"
                    DeltaTone="@(_lowStockCount > 0 ? StatusTone.Danger : StatusTone.Neutral)"
                    Href="/admin/products" />
        </OsRevealGroup>

        <div class="pg-admin__panels">
            <OsCard Padding="OsCard.CardPadding.Lg">
                <div class="os-card__head">
                    <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3">@L["Admin.Dashboard.RecentOrders"]</OsDisplay>
                    <OsButton Href="/admin/orders" Variant="OsButton.ButtonVariant.Ghost" Size="OsButton.ButtonSize.Sm"
                              EndIcon="@Icons.Material.Outlined.ArrowForward">
                        @L["Admin.Dashboard.ViewAll"]
                    </OsButton>
                </div>

                @if (!_stats.RecentOrders.Any())
                {
                    <OsEmptyState Icon="@Icons.Material.Outlined.Inbox" Title="@L["Admin.Dashboard.NoOrders"]" Compact="true" />
                }
                else
                {
                    <div class="os-rows">
                        @foreach (var order in _stats.RecentOrders)
                        {
                            <a class="os-row pg-admin__row" href="@($"/admin/orders/{order.Id}")" @key="order.Id">
                                <div class="os-row__main">
                                    <span class="os-row__title">@order.CustomerName</span>
                                    <span class="os-row__meta os-mono">
                                        #@order.Id.ToString("N")[..8].ToUpperInvariant() · @Formatting.DateTime(order.CreatedAt.ToLocalTime())
                                    </span>
                                </div>
                                <div class="os-row__end">
                                    <OsPrice Value="order.Total" Size="OsPrice.PriceSize.Sm" />
                                    <OsStatusChip Tone="StatusPresentation.OrderTone(order.Status)"
                                                  Text="@L[StatusPresentation.OrderLabelKey(order.Status)]"
                                                  Size="OsStatusChip.ChipSize.Sm" />
                                </div>
                            </a>
                        }
                    </div>
                }
            </OsCard>

            <OsCard Padding="OsCard.CardPadding.Lg">
                <div class="os-card__head">
                    <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3">@L["Admin.Dashboard.LowStock"]</OsDisplay>
                    <OsButton Href="/admin/products" Variant="OsButton.ButtonVariant.Ghost" Size="OsButton.ButtonSize.Sm"
                              EndIcon="@Icons.Material.Outlined.ArrowForward">
                        @L["Admin.Dashboard.Products"]
                    </OsButton>
                </div>

                @if (!_lowStockProducts.Any())
                {
                    <OsEmptyState Icon="@Icons.Material.Outlined.CheckCircle" Title="@L["Admin.Dashboard.AllGood"]" Compact="true" />
                }
                else
                {
                    <div class="os-rows">
                        @foreach (var p in _lowStockProducts)
                        {
                            <a class="os-row pg-admin__row" href="@($"/admin/products/{p.Id}")" @key="p.Id">
                                <div class="os-row__main">
                                    <span class="os-row__title">@p.Name</span>
                                    <span class="os-row__meta os-mono">@p.SKU</span>
                                </div>
                                <OsStatusChip Tone="@(p.Stock == 0 ? StatusTone.Danger : StatusTone.Warning)"
                                              Text="@p.Stock.ToString()"
                                              Size="OsStatusChip.ChipSize.Sm" />
                            </a>
                        }
                    </div>
                }
            </OsCard>
        </div>
    }
</OsSection>

@code {
    private OrderStatsDto? _stats;
    private List<AdminProductDto> _lowStockProducts = [];
    private int _lowStockCount;
    private int _totalProducts;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _stats = null;
        try
        {
            var stats = await AdminOrdering.GetStatsAsync();
            _stats = stats.Value;
            if (!stats.IsSuccess) Snackbar.ShowApiError(stats.Error);

            var products = await AdminCatalog.GetProductsAsync();
            if (products.IsSuccess)
            {
                var items = products.Value!;
                _lowStockProducts = items.Where(p => p.Stock < 10).OrderBy(p => p.Stock).Take(5).ToList();
                _lowStockCount = items.Count(p => p.Stock < 10);
                _totalProducts = items.Count;
            }
            else
            {
                Snackbar.ShowApiError(products.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.ShowError(L["Common.LoadError", ex.Message]);
        }
        finally
        {
            _loading = false;
        }
    }
}
