@page "/admin/users"
@inject IAdminUserClient AdminUsers
@inject ISnackbar Snackbar
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Admin.Users.PageTitle"]</PageTitle>

<AdminListShell Eyebrow="@L["Admin.Nav.Section"]"
                Title="@L["Admin.Users.Title"]"
                Subtitle="@L["Admin.Users.Subtitle"]"
                Loading="_loading"
                IsEmpty="@(_users.Count == 0)"
                EmptyIcon="@Icons.Material.Outlined.Group"
                EmptyTitle="@L["Admin.Users.None"]">
    <Filters>
        <MudTextField T="string" @bind-Value="_search" @bind-Value:after="StateHasChanged"
                      Placeholder="@L["Common.Search"]"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Outlined.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                      Class="pg-admin__filter" />
    </Filters>

    <ChildContent>
        <MudTable Items="Filtered" Hover="true" Elevation="0" Class="os-table"
                  RowsPerPage="25" Breakpoint="Breakpoint.Md">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<AdminUserSummaryDto, object>(u => u.DisplayName)">@L["Admin.Users.ColName"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<AdminUserSummaryDto, object>(u => u.Email)">@L["Admin.Users.ColEmail"]</MudTableSortLabel></MudTh>
                <MudTh Class="os-table__num"><MudTableSortLabel SortBy="new Func<AdminUserSummaryDto, object>(u => u.AddressCount)">@L["Admin.Users.ColAddresses"]</MudTableSortLabel></MudTh>
                <MudTh>@L["Admin.Users.ColDarkMode"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Admin.Users.ColName"]">
                    <span class="os-table__strong">@context.DisplayName</span>
                    <span class="os-table__sub os-mono">@context.Subject[..8]…</span>
                </MudTd>
                <MudTd DataLabel="@L["Admin.Users.ColEmail"]">@context.Email</MudTd>
                <MudTd DataLabel="@L["Admin.Users.ColAddresses"]" Class="os-table__num">
                    <span class="os-num">@context.AddressCount</span>
                </MudTd>
                <MudTd DataLabel="@L["Admin.Users.ColDarkMode"]">
                    @* A chip, not an icon: an icon alone left the column unreadable for
                       anyone who could not tell sun from moon at 18px. *@
                    <OsStatusChip Tone="StatusTone.Neutral"
                                  Size="OsStatusChip.ChipSize.Sm"
                                  Text="@(context.DarkModeEnabled ? L["Theme.Dark"] : L["Theme.Light"])" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="@L["Admin.Table.RowsPerPage"]" />
            </PagerContent>
        </MudTable>
    </ChildContent>
</AdminListShell>

@code {
    private List<AdminUserSummaryDto> _users = [];
    private bool _loading = true;
    private string _search = string.Empty;

    private IEnumerable<AdminUserSummaryDto> Filtered =>
        string.IsNullOrWhiteSpace(_search)
            ? _users
            : _users.Where(u =>
                u.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                u.Email.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var r = await AdminUsers.GetUsersAsync();
            if (r.IsSuccess) _users = r.Value!;
            else Snackbar.ShowApiError(r.Error);
        }
        catch (Exception ex) { Snackbar.ShowError(L["Common.Error", ex.Message]); }
        finally { _loading = false; }
    }
}
