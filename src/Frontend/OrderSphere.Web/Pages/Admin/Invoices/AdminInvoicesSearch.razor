@page "/admin/invoices"
@inject IAdminInvoicingClient AdminInvoicing
@inject ISnackbar Snackbar
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Admin.Invoices.PageTitle"]</PageTitle>

<OsPageHeader Eyebrow="@L["Admin.Nav.Section"]"
              Title="@L["Admin.Invoices.Title"]"
              Subtitle="@L["Admin.Invoices.Subtitle"]"
              Size="OsDisplay.DisplaySize.D3"
              Padding="OsPageHeader.HeaderPadding.Sm" />

<OsSection Padding="OsSection.SectionPadding.Sm" Width="OsSection.SectionWidth.Narrow">
    <div class="pg-admin__search">
        <MudTextField @bind-Value="_query" Immediate="true"
                      Label="@L["Admin.Invoices.SearchLabel"]"
                      Placeholder="@L["Admin.Invoices.SearchPlaceholder"]"
                      Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                      OnKeyDown="OnSearchKeyDown" />
        <OsButton OnClick="SearchAsync" Loading="_searching" Disabled="@string.IsNullOrWhiteSpace(_query)">
            @L["Admin.Invoices.SearchButton"]
        </OsButton>
    </div>

    @if (_searching)
    {
        <OsListSkeleton Rows="1" />
    }
    else if (_result is not null)
    {
        <OsCard Padding="OsCard.CardPadding.Lg" Class="pg-admin__invoice">
            <div class="os-card__head">
                <div>
                    <OsEyebrow Text="@L["Admin.Invoices.ColNumber"]" Tone="OsEyebrow.EyebrowTone.Muted" Rule="false" />
                    <span class="pg-admin__invoice-number os-mono">@_result.InvoiceNumber</span>
                </div>
                <OsStatusChip Tone="StatusPresentation.InvoiceTone(_result.Status)"
                              Text="@L[StatusPresentation.InvoiceLabelKey(_result.Status)]"
                              Dot="true" />
            </div>

            <dl class="os-kv">
                <div class="os-kv__row">
                    <dt class="os-kv__key">@L["Admin.Invoices.ColOrder"]</dt>
                    <dd class="os-kv__val os-mono">#@_result.OrderId.ToString("N")[..8].ToUpperInvariant()</dd>
                </div>
                <div class="os-kv__row">
                    <dt class="os-kv__key">@L["Admin.Invoices.ColCustomer"]</dt>
                    <dd class="os-kv__val">@_result.CustomerName</dd>
                </div>
                <div class="os-kv__row">
                    <dt class="os-kv__key">@L["Admin.Invoices.ColEmail"]</dt>
                    <dd class="os-kv__val">@_result.CustomerEmail</dd>
                </div>
                <div class="os-kv__row">
                    <dt class="os-kv__key">@L["Admin.Invoices.ColDate"]</dt>
                    <dd class="os-kv__val os-mono">@Formatting.DateTime(_result.IssuedAt.ToLocalTime())</dd>
                </div>
                <div class="os-kv__row os-kv__row--total">
                    <dt class="os-kv__key">@L["Admin.Invoices.ColAmount"]</dt>
                    <dd class="os-kv__val">@Formatting.Currency(_result.Total)</dd>
                </div>
            </dl>

            <div class="os-card__actions">
                <OsButton Href="@($"/admin/invoices/{_result.Id}")"
                          StartIcon="@Icons.Material.Outlined.OpenInNew">
                    @L["Admin.Invoices.ViewDetail"]
                </OsButton>
                <OsButton Href="@AdminInvoicing.GetPdfUrl(_result.OrderId)" Target="_blank"
                          Variant="OsButton.ButtonVariant.Secondary"
                          StartIcon="@Icons.Material.Outlined.PictureAsPdf">
                    @L["Admin.Invoices.ViewInvoice"]
                </OsButton>
            </div>
        </OsCard>
    }
    else if (_notFound)
    {
        <OsEmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="@L["Admin.Invoices.NoResults"]" />
    }
    else
    {
        <OsEmptyState Icon="@Icons.Material.Outlined.ReceiptLong" Title="@L["Admin.Invoices.Prompt"]" Compact="true" />
    }
</OsSection>

@code {
    private string _query = string.Empty;
    private bool _searching;
    private bool _notFound;
    private AdminInvoiceDto? _result;

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
            await SearchAsync();
    }

    private async Task SearchAsync()
    {
        var number = _query.Trim();
        if (string.IsNullOrEmpty(number))
            return;

        _searching = true;
        _notFound = false;
        _result = null;
        try
        {
            var result = await AdminInvoicing.GetByNumberAsync(number);
            if (result.IsSuccess)
            {
                _result = result.Value;
            }
            else if (result.Error!.Kind == ApiErrorKind.NotFound)
            {
                _notFound = true;
            }
            else
            {
                Snackbar.ShowApiError(result.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.ShowError(L["Common.LoadError", ex.Message]);
        }
        finally
        {
            _searching = false;
        }
    }
}
