@page "/admin/invoices/{InvoiceId:guid}"
@inject IAdminInvoicingClient AdminInvoicing
@inject ISnackbar Snackbar
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Admin.Invoices.Detail.PageTitle"]</PageTitle>

<OsPageHeader Eyebrow="@L["Admin.Nav.Section"]"
              Title="@(_invoice?.InvoiceNumber ?? L["Admin.Invoices.Detail.PageTitle"])"
              Breadcrumbs="Crumbs"
              Size="OsDisplay.DisplaySize.D3"
              Padding="OsPageHeader.HeaderPadding.Sm">
    <Actions>
        @if (_invoice is not null)
        {
            <OsStatusChip Tone="StatusPresentation.InvoiceTone(_invoice.Status)"
                          Text="@L[StatusPresentation.InvoiceLabelKey(_invoice.Status)]"
                          Dot="true" />
        }
    </Actions>
</OsPageHeader>

<OsSection Padding="OsSection.SectionPadding.Sm" Width="OsSection.SectionWidth.Wide">
    @if (_loading)
    {
        <OsDetailSkeleton />
    }
    else if (_invoice is null)
    {
        <OsEmptyState Icon="@Icons.Material.Outlined.SearchOff"
                      Title="@L["Admin.Invoices.Detail.NotFound"]"
                      ActionText="@L["Admin.Invoices.Detail.BackToList"]"
                      ActionHref="/admin/invoices" />
    }
    else
    {
        <div class="pg-order">
            <div class="pg-order__main os-stack">
                <OsCard Padding="OsCard.CardPadding.Lg">
                    <div class="os-card__head">
                        <div>
                            <OsEyebrow Text="@L["Admin.Invoices.ColNumber"]" Tone="OsEyebrow.EyebrowTone.Muted" Rule="false" />
                            <div class="pg-order__number os-mono">@_invoice.InvoiceNumber</div>
                            <div class="pg-order__placed os-mono">@Formatting.DateTime(_invoice.IssuedAt.ToLocalTime())</div>
                        </div>
                    </div>

                    <dl class="os-kv">
                        <div class="os-kv__row">
                            <dt class="os-kv__key">@L["Admin.Invoices.ColCustomer"]</dt>
                            <dd class="os-kv__val">@_invoice.CustomerName</dd>
                        </div>
                        <div class="os-kv__row">
                            <dt class="os-kv__key">@L["Admin.Invoices.ColEmail"]</dt>
                            <dd class="os-kv__val">@_invoice.CustomerEmail</dd>
                        </div>
                        <div class="os-kv__row">
                            <dt class="os-kv__key">@L["Admin.Invoices.ColOrder"]</dt>
                            <dd class="os-kv__val os-mono">
                                <a href="@($"/admin/orders/{_invoice.OrderId}")">#@_invoice.OrderId.ToString("N")[..8].ToUpperInvariant()</a>
                            </dd>
                        </div>
                    </dl>

                    <div class="os-card__actions">
                        <OsButton Href="@AdminInvoicing.GetPdfUrl(_invoice.OrderId)" Target="_blank"
                                  Variant="OsButton.ButtonVariant.Secondary"
                                  StartIcon="@Icons.Material.Outlined.PictureAsPdf">
                            @L["Admin.Invoices.ViewInvoice"]
                        </OsButton>
                    </div>
                </OsCard>

                <OsCard Padding="OsCard.CardPadding.Lg">
                    <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3">@L["Admin.Invoices.Detail.OriginalAmounts"]</OsDisplay>
                    <dl class="os-kv">
                        <div class="os-kv__row">
                            <dt class="os-kv__key">@L["Admin.Invoices.Detail.Net"]</dt>
                            <dd class="os-kv__val os-num">@Formatting.Currency(_invoice.NetAmount)</dd>
                        </div>
                        <div class="os-kv__row">
                            <dt class="os-kv__key">
                                @L["Admin.Invoices.Detail.Tax"] <span class="os-mono">(@_invoice.TaxRate.ToString("P0"))</span>
                            </dt>
                            <dd class="os-kv__val os-num">@Formatting.Currency(_invoice.TaxAmount)</dd>
                        </div>
                        <div class="os-kv__row os-kv__row--total">
                            <dt class="os-kv__key">@L["Admin.Invoices.Detail.Total"]</dt>
                            <dd class="os-kv__val">@Formatting.Currency(_invoice.Total)</dd>
                        </div>
                    </dl>
                </OsCard>

                @if (_invoice.Adjustments.Count > 0)
                {
                    <OsCard Padding="OsCard.CardPadding.Lg">
                        <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3">@L["Admin.Invoices.Detail.AdjustedAmounts"]</OsDisplay>
                        <dl class="os-kv">
                            <div class="os-kv__row">
                                <dt class="os-kv__key">@L["Admin.Invoices.Detail.Net"]</dt>
                                <dd class="os-kv__val os-num">@Formatting.Currency(_invoice.AdjustedNet)</dd>
                            </div>
                            <div class="os-kv__row">
                                <dt class="os-kv__key">@L["Admin.Invoices.Detail.Tax"]</dt>
                                <dd class="os-kv__val os-num">@Formatting.Currency(_invoice.AdjustedTax)</dd>
                            </div>
                            <div class="os-kv__row os-kv__row--total">
                                <dt class="os-kv__key">@L["Admin.Invoices.Detail.AdjustedTotal"]</dt>
                                <dd class="os-kv__val">@Formatting.Currency(_invoice.AdjustedTotal)</dd>
                            </div>
                        </dl>

                        <OsEyebrow Text="@L["Admin.Invoices.Detail.History"]" />
                        <div class="os-table-wrap">
                            <table class="os-table os-table--plain">
                                <thead>
                                    <tr>
                                        <th scope="col">@L["Admin.Invoices.Detail.ColType"]</th>
                                        <th scope="col">@L["Admin.Invoices.Detail.ColReason"]</th>
                                        <th scope="col" class="os-table__num">@L["Admin.Invoices.ColAmount"]</th>
                                        <th scope="col">@L["Admin.Invoices.Detail.ColAppliedBy"]</th>
                                        <th scope="col">@L["Admin.Invoices.ColDate"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var adjustment in _invoice.Adjustments)
                                    {
                                        <tr>
                                            <td>
                                                <OsStatusChip Tone="@(adjustment.Type == "Credit" ? StatusTone.Info : StatusTone.Warning)"
                                                              Text="@AdjustmentTypeLabel(adjustment.Type)"
                                                              Size="OsStatusChip.ChipSize.Sm" />
                                            </td>
                                            <td>@adjustment.Reason</td>
                                            <td class="os-table__num"><span class="os-num">−@Formatting.Currency(adjustment.AmountNet)</span></td>
                                            <td>@adjustment.AppliedBy</td>
                                            <td><span class="os-mono">@Formatting.DateTime(adjustment.AppliedAt.ToLocalTime())</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </OsCard>
                }
            </div>

            <aside class="pg-order__aside">
                <OsCard Padding="OsCard.CardPadding.Lg" Class="pg-admin__rail-card">
                    <OsEyebrow Text="@L["Admin.Invoices.Detail.ApplyDiscount"]" />

                    @* A form, so the reason and a positive amount are enforced by the
                       same validation the rest of the admin uses, not by a bool. *@
                    <MudForm @ref="_discountForm" @bind-IsValid="_discountValid" Class="pg-admin__form">
                        <MudRadioGroup T="string" @bind-Value="_discountMode">
                            <MudRadio T="string" Value="@("absolute")" Color="Color.Primary">@L["Admin.Invoices.Detail.DiscountModeAbsolute"]</MudRadio>
                            <MudRadio T="string" Value="@("percentage")" Color="Color.Primary">@L["Admin.Invoices.Detail.DiscountModePercentage"]</MudRadio>
                        </MudRadioGroup>

                        @if (_discountMode == "absolute")
                        {
                            <MudNumericField T="decimal?" @bind-Value="_discountAmount"
                                             Label="@L["Admin.Invoices.Detail.AmountLabel"]"
                                             Variant="Variant.Outlined" ShrinkLabel="true" Margin="Margin.Dense"
                                             Min="0.01m" Required="true" RequiredError="@L["Validation.Required"]" />
                        }
                        else
                        {
                            <MudNumericField T="decimal?" @bind-Value="_discountPercentage"
                                             Label="@L["Admin.Invoices.Detail.PercentageLabel"]"
                                             Variant="Variant.Outlined" ShrinkLabel="true" Margin="Margin.Dense"
                                             Min="0.01m" Max="100m" Required="true" RequiredError="@L["Validation.Required"]" />
                        }

                        <MudTextField T="string" @bind-Value="_discountReason"
                                      Label="@L["Admin.Invoices.Detail.ReasonLabel"]"
                                      Variant="Variant.Outlined" ShrinkLabel="true" Margin="Margin.Dense" Lines="2"
                                      Required="true" RequiredError="@L["Validation.Required"]" />
                    </MudForm>

                    <OsButton FullWidth="true" Loading="_busy" Disabled="@(!_discountValid)"
                              OnClick="SubmitDiscountAsync">
                        @L["Admin.Invoices.Detail.SubmitDiscount"]
                    </OsButton>
                </OsCard>

                <OsCard Padding="OsCard.CardPadding.Lg">
                    <OsEyebrow Text="@L["Admin.Invoices.Detail.IssueCredit"]" />

                    <MudForm @ref="_creditForm" @bind-IsValid="_creditValid" Class="pg-admin__form">
                        <MudNumericField T="decimal?" @bind-Value="_creditAmount"
                                         Label="@L["Admin.Invoices.Detail.AmountLabel"]"
                                         Variant="Variant.Outlined" ShrinkLabel="true" Margin="Margin.Dense"
                                         Min="0.01m" Required="true" RequiredError="@L["Validation.Required"]" />
                        <MudTextField T="string" @bind-Value="_creditReason"
                                      Label="@L["Admin.Invoices.Detail.ReasonLabel"]"
                                      Variant="Variant.Outlined" ShrinkLabel="true" Margin="Margin.Dense" Lines="2"
                                      Required="true" RequiredError="@L["Validation.Required"]" />
                    </MudForm>

                    <OsButton FullWidth="true" Variant="OsButton.ButtonVariant.Secondary"
                              Loading="_busy" Disabled="@(!_creditValid)"
                              OnClick="SubmitCreditAsync">
                        @L["Admin.Invoices.Detail.SubmitCredit"]
                    </OsButton>
                </OsCard>
            </aside>
        </div>
    }
</OsSection>

@code {
    [Parameter] public Guid InvoiceId { get; set; }

    private AdminInvoiceDto? _invoice;
    private bool _loading = true;
    private bool _busy;

    private MudForm _discountForm = default!;
    private bool _discountValid;
    private string _discountMode = "absolute";
    private decimal? _discountAmount;
    private decimal? _discountPercentage;
    private string _discountReason = string.Empty;

    private MudForm _creditForm = default!;
    private bool _creditValid;
    private decimal? _creditAmount;
    private string _creditReason = string.Empty;

    private IReadOnlyList<OsCrumb> Crumbs =>
    [
        new OsCrumb(L["Admin.Invoices.Title"], "/admin/invoices"),
        new OsCrumb(_invoice?.InvoiceNumber ?? "—"),
    ];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await AdminInvoicing.GetByIdAsync(InvoiceId);
            _invoice = result.Value;
            if (!result.IsSuccess && result.Error!.Kind != ApiErrorKind.NotFound)
                Snackbar.ShowApiError(result.Error);
        }
        catch (Exception ex)
        {
            Snackbar.ShowError(L["Common.LoadError", ex.Message]);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SubmitDiscountAsync()
    {
        await _discountForm.ValidateAsync();
        if (!_discountForm.IsValid) return;

        _busy = true;
        try
        {
            var result = _discountMode == "absolute"
                ? await AdminInvoicing.ApplyDiscountAsync(InvoiceId, _discountAmount, null, _discountReason)
                : await AdminInvoicing.ApplyDiscountAsync(InvoiceId, null, _discountPercentage, _discountReason);

            if (result.IsSuccess)
            {
                Snackbar.ShowSuccess(L["Admin.Invoices.Detail.AdjustmentApplied"]);
                _invoice = result.Value;
                _discountAmount = null;
                _discountPercentage = null;
                _discountReason = string.Empty;
                await _discountForm.ResetAsync();
            }
            else
            {
                Snackbar.ShowApiError(result.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitCreditAsync()
    {
        await _creditForm.ValidateAsync();
        if (!_creditForm.IsValid) return;

        _busy = true;
        try
        {
            var result = await AdminInvoicing.IssueCreditNoteAsync(InvoiceId, _creditAmount!.Value, _creditReason);
            if (result.IsSuccess)
            {
                Snackbar.ShowSuccess(L["Admin.Invoices.Detail.AdjustmentApplied"]);
                _invoice = result.Value;
                _creditAmount = null;
                _creditReason = string.Empty;
                await _creditForm.ResetAsync();
            }
            else
            {
                Snackbar.ShowApiError(result.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private string AdjustmentTypeLabel(string type) => type switch
    {
        "Discount" => L["Admin.Invoices.Detail.TypeDiscount"],
        "Credit" => L["Admin.Invoices.Detail.TypeCredit"],
        _ => type,
    };
}
