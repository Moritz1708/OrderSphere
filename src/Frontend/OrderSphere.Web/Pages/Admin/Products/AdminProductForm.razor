@page "/admin/products/new"
@page "/admin/products/{ProductId:guid}"
@inject IAdminCatalogClient AdminCatalog
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IMotionService Motion
@inject IStringLocalizer<AppStrings> L

<PageTitle>@(IsEdit ? L["Admin.ProductForm.PageTitleEdit"] : L["Admin.ProductForm.PageTitleCreate"])</PageTitle>

<OsPageHeader Eyebrow="@L["Admin.Nav.Section"]"
              Title="@(IsEdit ? L["Admin.ProductForm.TitleEdit"] : L["Admin.ProductForm.TitleCreate"])"
              Breadcrumbs="Crumbs"
              Size="OsDisplay.DisplaySize.D3"
              Padding="OsPageHeader.HeaderPadding.Sm" />

<OsSection Padding="OsSection.SectionPadding.Sm" Width="OsSection.SectionWidth.Narrow">
    @if (_loading)
    {
        <OsDetailSkeleton />
    }
    else
    {
        <MudForm @ref="_form" @bind-IsValid="_valid" Class="os-form-grid pg-admin-form">
            <MudTextField T="string" @bind-Value="_model.Name" Label="@L["Admin.ProductForm.Name"]"
                          Variant="Variant.Outlined" ShrinkLabel="true" Class="os-form-grid__full"
                          Required="true" RequiredError="@L["Admin.ProductForm.NameRequired"]" />

            <MudTextField T="string" @bind-Value="_model.SKU" Label="@L["Admin.ProductForm.SKU"]"
                          Variant="Variant.Outlined" ShrinkLabel="true" Class="os-mono"
                          Required="true" RequiredError="@L["Admin.ProductForm.SKURequired"]" />

            <MudSelect T="Guid" @bind-Value="_model.CategoryId" Label="@L["Admin.ProductForm.Category"]"
                       Variant="Variant.Outlined" ShrinkLabel="true"
                       Required="true" RequiredError="@L["Admin.ProductForm.CategoryRequired"]"
                       Validation="@(new Func<Guid, string?>(ValidateCategory))">
                @foreach (var cat in _categories)
                {
                    <MudSelectItem T="Guid" Value="@cat.Id">@cat.Name</MudSelectItem>
                }
            </MudSelect>

            <MudTextField T="string" @bind-Value="_model.Description" Label="@L["Admin.ProductForm.Description"]"
                          Variant="Variant.Outlined" ShrinkLabel="true" Lines="4"
                          Class="os-form-grid__full" />

            <MudNumericField T="decimal" @bind-Value="_model.Price" Label="@L["Admin.ProductForm.Price"]"
                             Variant="Variant.Outlined" ShrinkLabel="true"
                             Min="0.01m" Step="0.01m" Format="F2"
                             Culture="@System.Globalization.CultureInfo.CurrentCulture"
                             Required="true" RequiredError="@L["Validation.Required"]" />

            <MudNumericField T="int" @bind-Value="_model.Stock" Label="@L["Admin.ProductForm.Stock"]"
                             Variant="Variant.Outlined" ShrinkLabel="true" Min="0"
                             Required="true" RequiredError="@L["Validation.Required"]" />

            @if (IsEdit)
            {
                <MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Primary"
                           Class="os-form-grid__full"
                           Label="@L["Admin.ProductForm.ActiveLabel"]" />
            }
        </MudForm>

        <div class="os-actionbar">
            <OsButton Href="/admin/products" Variant="OsButton.ButtonVariant.Ghost">
                @L["Common.Cancel"]
            </OsButton>
            <OsButton OnClick="SaveAsync" Loading="_saving" Disabled="@(!_valid)"
                      StartIcon="@Icons.Material.Outlined.Save">
                @(IsEdit ? L["Common.Save"] : L["Common.Create"])
            </OsButton>
        </div>
    }
</OsSection>

@code {
    [Parameter] public Guid? ProductId { get; set; }

    private bool IsEdit => ProductId.HasValue;
    private bool _loading = true;
    private bool _saving;
    private MudForm _form = default!;
    private bool _valid;
    private List<AdminCategoryDto> _categories = [];
    private ProductModel _model = new();

    private IReadOnlyList<OsCrumb> Crumbs =>
    [
        new OsCrumb(L["Admin.Products.Title"], "/admin/products"),
        new OsCrumb(IsEdit ? L["Admin.ProductForm.TitleEdit"].Value : L["Admin.ProductForm.TitleCreate"].Value),
    ];

    // MudSelect's Required only fires on an untouched field; an empty Guid slips through.
    private string? ValidateCategory(Guid id)
        => id == Guid.Empty ? L["Admin.ProductForm.CategoryRequired"].Value : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cats = await AdminCatalog.GetCategoriesAsync();
            if (cats.IsSuccess) _categories = cats.Value!;
            else Snackbar.ShowApiError(cats.Error);

            if (IsEdit)
            {
                var p = (await AdminCatalog.GetProductByIdAsync(ProductId!.Value)).Value;
                if (p is not null)
                {
                    _model = new ProductModel
                    {
                        Name = p.Name,
                        SKU = p.SKU,
                        Description = p.Description,
                        Price = p.Price,
                        Stock = p.Stock,
                        CategoryId = p.CategoryId,
                        IsActive = p.IsActive,
                    };
                }
            }
        }
        catch (Exception ex) { Snackbar.ShowError(L["Common.Error", ex.Message]); }
        finally { _loading = false; }
    }

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            await Motion.FocusFirstInvalidAsync();
            return;
        }

        _saving = true;
        try
        {
            var input = new AdminProductInput(_model.Name, _model.Description, _model.Price,
                _model.Stock, _model.CategoryId, _model.SKU, _model.IsActive);

            ApiError? error;
            if (IsEdit)
            {
                var result = await AdminCatalog.UpdateProductAsync(ProductId!.Value, input);
                error = result.IsSuccess ? null : result.Error;
            }
            else
            {
                var result = await AdminCatalog.CreateProductAsync(input);
                error = result.IsSuccess ? null : result.Error;
            }

            if (error is null)
            {
                Snackbar.ShowSuccess(IsEdit ? L["Admin.ProductForm.Saved"] : L["Admin.ProductForm.Created"]);
                Navigation.NavigateTo("/admin/products");
            }
            else
            {
                Snackbar.ShowApiError(error);
            }
        }
        finally { _saving = false; }
    }

    private sealed class ProductModel
    {
        public string Name { get; set; } = string.Empty;
        public string SKU { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Price { get; set; } = 0.01m;
        public int Stock { get; set; }
        public Guid CategoryId { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
