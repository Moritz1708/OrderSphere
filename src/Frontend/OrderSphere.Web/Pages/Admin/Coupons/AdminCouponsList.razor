@page "/admin/coupons"
@inject IAdminOrderingClient AdminOrdering
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Admin.Coupons.PageTitle"]</PageTitle>

<AdminListShell Eyebrow="@L["Admin.Nav.Section"]"
                Title="@L["Admin.Coupons.Title"]"
                Subtitle="@L["Admin.Coupons.Subtitle"]"
                Loading="_loading"
                IsEmpty="@(_coupons.Count == 0)"
                EmptyIcon="@Icons.Material.Outlined.LocalOffer"
                EmptyTitle="@L["Admin.Coupons.None"]"
                EmptyActionText="@L["Admin.Coupons.New"]"
                OnEmptyAction="@(_ => OpenCreate())">
    <Actions>
        <OsButton OnClick="OpenCreate" StartIcon="@Icons.Material.Outlined.Add">
            @L["Admin.Coupons.New"]
        </OsButton>
    </Actions>

    <ChildContent>
        <MudTable Items="_coupons" Hover="true" Elevation="0" Class="os-table"
                  RowsPerPage="25" Breakpoint="Breakpoint.Md">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<AdminCouponDto, object>(c => c.Code)">@L["Admin.Coupons.ColCode"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<AdminCouponDto, object>(c => c.Value)">@L["Admin.Coupons.ColDiscount"]</MudTableSortLabel></MudTh>
                <MudTh>@L["Admin.Coupons.ColMinSubtotal"]</MudTh>
                <MudTh>@L["Admin.Coupons.ColValidity"]</MudTh>
                <MudTh Class="os-table__num"><MudTableSortLabel SortBy="new Func<AdminCouponDto, object>(c => c.RedeemedCount)">@L["Admin.Coupons.ColUsage"]</MudTableSortLabel></MudTh>
                <MudTh>@L["Admin.Coupons.ColStatus"]</MudTh>
                <MudTh Class="os-table__end">@L["Admin.Coupons.ColAction"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Admin.Coupons.ColCode"]">
                    <span class="os-mono os-table__strong">@context.Code</span>
                </MudTd>
                <MudTd DataLabel="@L["Admin.Coupons.ColDiscount"]">
                    <span class="os-num">@DiscountLabel(context)</span>
                </MudTd>
                <MudTd DataLabel="@L["Admin.Coupons.ColMinSubtotal"]">
                    <span class="os-num">@(context.MinSubtotal is { } min ? Formatting.Currency(min) : "—")</span>
                </MudTd>
                <MudTd DataLabel="@L["Admin.Coupons.ColValidity"]">
                    <span class="os-mono">@ValidityLabel(context)</span>
                </MudTd>
                <MudTd DataLabel="@L["Admin.Coupons.ColUsage"]" Class="os-table__num">
                    <span class="os-num">@UsageLabel(context)</span>
                </MudTd>
                <MudTd DataLabel="@L["Admin.Coupons.ColStatus"]">
                    <OsStatusChip Tone="StatusPresentation.ActiveTone(context.IsActive)"
                                  Text="@(context.IsActive ? L["Common.Active"] : L["Common.Inactive"])"
                                  Size="OsStatusChip.ChipSize.Sm" />
                </MudTd>
                <MudTd DataLabel="@L["Admin.Coupons.ColAction"]" Class="os-table__end">
                    <div class="os-table__actions">
                        <OsIconButton Icon="@Icons.Material.Outlined.Edit"
                                      Size="OsIconButton.IconButtonSize.Sm"
                                      OnClick="@(() => OpenEdit(context))"
                                      AriaLabel="@L["Admin.EditCouponAria"]" />
                        <OsIconButton Icon="@Icons.Material.Outlined.Block"
                                      Size="OsIconButton.IconButtonSize.Sm"
                                      Disabled="@(!context.IsActive)"
                                      OnClick="@(() => DeactivateAsync(context))"
                                      AriaLabel="@L["Admin.DeactivateCouponAria"]" />
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="@L["Admin.Table.RowsPerPage"]" />
            </PagerContent>
        </MudTable>
    </ChildContent>
</AdminListShell>

<MudDialog @bind-Visible="_dialogOpen">
    <TitleContent>
        <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3">
            @(_editingId is null ? L["Admin.Coupons.CreateTitle"] : L["Admin.Coupons.EditTitle"])
        </OsDisplay>
    </TitleContent>
    <DialogContent>
        @* MudForm, so Save can stay disabled until the code and value are usable. *@
        <MudForm @ref="_form" @bind-IsValid="_formValid" Class="os-form-grid">
            <MudTextField T="string" @bind-Value="_code" Label="@L["Admin.Coupons.FieldCode"]"
                          Variant="Variant.Outlined" ShrinkLabel="true"
                          Disabled="@(_editingId is not null)"
                          Required="true" RequiredError="@L["Validation.Required"]" />
            <MudSelect T="int" @bind-Value="_discountType" Label="@L["Admin.Coupons.FieldType"]"
                       Variant="Variant.Outlined" ShrinkLabel="true">
                <MudSelectItem Value="0">@L["Admin.Coupons.TypeFlat"]</MudSelectItem>
                <MudSelectItem Value="1">@L["Admin.Coupons.TypePercentage"]</MudSelectItem>
            </MudSelect>
            <MudNumericField T="decimal" @bind-Value="_value" Label="@L["Admin.Coupons.FieldValue"]"
                             Variant="Variant.Outlined" ShrinkLabel="true" Min="0.01m"
                             Required="true" RequiredError="@L["Validation.Required"]" />
            <MudNumericField T="decimal?" @bind-Value="_minSubtotal" Label="@L["Admin.Coupons.FieldMinSubtotal"]"
                             Variant="Variant.Outlined" ShrinkLabel="true" Min="0" />
            <MudDatePicker @bind-Date="_validFrom" Label="@L["Admin.Coupons.FieldValidFrom"]"
                           Variant="Variant.Outlined" ShrinkLabel="true" Clearable="true" />
            <MudDatePicker @bind-Date="_validUntil" Label="@L["Admin.Coupons.FieldValidUntil"]"
                           Variant="Variant.Outlined" ShrinkLabel="true" Clearable="true" />
            <MudNumericField T="int?" @bind-Value="_maxRedemptions" Label="@L["Admin.Coupons.FieldMaxRedemptions"]"
                             Variant="Variant.Outlined" ShrinkLabel="true" Min="1" />
            <MudSwitch T="bool" @bind-Value="_isActive" Color="Color.Primary" Label="@L["Admin.Coupons.FieldActive"]" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <OsButton Variant="OsButton.ButtonVariant.Ghost" OnClick="@(() => _dialogOpen = false)">
            @L["Common.Cancel"]
        </OsButton>
        <OsButton OnClick="SaveAsync" Loading="_saving" Disabled="@(!_formValid)">
            @L["Common.Save"]
        </OsButton>
    </DialogActions>
</MudDialog>

@code {
    private List<AdminCouponDto> _coupons = [];
    private bool _loading = true;

    private bool _dialogOpen;
    private bool _saving;
    private MudForm _form = default!;
    private bool _formValid;
    private Guid? _editingId;
    private string _code = string.Empty;
    private int _discountType;
    private decimal _value;
    private decimal? _minSubtotal;
    private DateTime? _validFrom;
    private DateTime? _validUntil;
    private int? _maxRedemptions;
    private bool _isActive = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var r = await AdminOrdering.GetCouponsAsync();
            if (r.IsSuccess) _coupons = r.Value!;
            else Snackbar.ShowApiError(r.Error);
        }
        catch (Exception ex) { Snackbar.ShowError(L["Common.Error", ex.Message]); }
        finally { _loading = false; }
    }

    private void OpenCreate()
    {
        _editingId = null;
        _code = string.Empty;
        _discountType = 0;
        _value = 0;
        _minSubtotal = null;
        _validFrom = null;
        _validUntil = null;
        _maxRedemptions = null;
        _isActive = true;
        _formValid = false;
        _dialogOpen = true;
    }

    private void OpenEdit(AdminCouponDto c)
    {
        _editingId = c.Id;
        _code = c.Code;
        _discountType = c.DiscountType;
        _value = c.Value;
        _minSubtotal = c.MinSubtotal;
        _validFrom = c.ValidFrom;
        _validUntil = c.ValidUntil;
        _maxRedemptions = c.MaxRedemptions;
        _isActive = c.IsActive;
        _formValid = true;
        _dialogOpen = true;
    }

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;

        _saving = true;
        try
        {
            var input = new AdminCouponInput(_code, _discountType, _value, _minSubtotal,
                _validFrom, _validUntil, _maxRedemptions, _isActive);

            ApiError? error;
            if (_editingId is { } id)
            {
                var result = await AdminOrdering.UpdateCouponAsync(id, input);
                error = result.IsSuccess ? null : result.Error;
            }
            else
            {
                var result = await AdminOrdering.CreateCouponAsync(input);
                error = result.IsSuccess ? null : result.Error;
            }

            if (error is null)
            {
                Snackbar.ShowSuccess(L["Admin.Coupons.Saved"]);
                _dialogOpen = false;
                await LoadAsync();
            }
            else
            {
                Snackbar.ShowApiError(error);
            }
        }
        finally { _saving = false; }
    }

    // Deactivating stops redemptions for everyone holding the code, so it asks first.
    private async Task DeactivateAsync(AdminCouponDto c)
    {
        var confirmed = await ConfirmDialog.ShowAsync(
            Dialogs,
            L["Admin.Confirm.DeactivateCouponTitle"],
            L["Admin.Confirm.DeactivateCouponBody", c.Code],
            L["Admin.Coupons.Deactivate"],
            danger: true);

        if (!confirmed) return;

        var result = await AdminOrdering.DeactivateCouponAsync(c.Id);
        if (result.IsSuccess)
        {
            Snackbar.ShowSuccess(L["Admin.Coupons.Deactivated"]);
            await LoadAsync();
        }
        else
        {
            Snackbar.ShowApiError(result.Error);
        }
    }

    private string DiscountLabel(AdminCouponDto c)
        => c.DiscountType == 1 ? $"{c.Value:0.#}%" : Formatting.Currency(c.Value);

    private string ValidityLabel(AdminCouponDto c)
    {
        var from = c.ValidFrom is { } f ? Formatting.Date(f) : "—";
        var until = c.ValidUntil is { } u ? Formatting.Date(u) : "—";
        return c.ValidFrom is null && c.ValidUntil is null ? "—" : $"{from} – {until}";
    }

    private string UsageLabel(AdminCouponDto c)
        => c.MaxRedemptions is { } max ? $"{c.RedeemedCount} / {max}" : $"{c.RedeemedCount} / ∞";
}
