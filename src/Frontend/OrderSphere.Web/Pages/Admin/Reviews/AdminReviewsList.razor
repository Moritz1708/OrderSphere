@page "/admin/reviews"
@inject IAdminCatalogClient AdminCatalog
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Admin.Reviews.PageTitle"]</PageTitle>

<AdminListShell Eyebrow="@L["Admin.Nav.Section"]"
                Title="@L["Admin.Reviews.Title"]"
                Subtitle="@L["Admin.Reviews.Subtitle"]"
                Loading="_loading"
                IsEmpty="@(_reviews.Count == 0)"
                EmptyIcon="@Icons.Material.Outlined.RateReview"
                EmptyTitle="@L["Admin.Reviews.None"]">
    <ChildContent>
        <MudTable Items="_reviews" Hover="true" Elevation="0" Class="os-table"
                  RowsPerPage="25" Breakpoint="Breakpoint.Md">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<ReviewDto, object>(r => r.Rating)">@L["Admin.Reviews.ColRating"]</MudTableSortLabel></MudTh>
                <MudTh>@L["Admin.Reviews.ColReview"]</MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ReviewDto, object>(r => r.Status ?? string.Empty)">@L["Admin.Reviews.ColStatus"]</MudTableSortLabel></MudTh>
                <MudTh Class="os-table__end">@L["Admin.Reviews.ColAction"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Admin.Reviews.ColRating"]">
                    <StarRating Value="context.Rating" ShowCount="false" />
                </MudTd>
                <MudTd DataLabel="@L["Admin.Reviews.ColReview"]">
                    <span class="os-table__strong">@context.Title</span>
                    <span class="os-table__sub">@context.Body</span>
                </MudTd>
                <MudTd DataLabel="@L["Admin.Reviews.ColStatus"]">
                    <OsStatusChip Tone="StatusPresentation.ReviewTone(context.Status)"
                                  Text="@L[StatusPresentation.ReviewLabelKey(context.Status)]"
                                  Size="OsStatusChip.ChipSize.Sm" />
                </MudTd>
                <MudTd DataLabel="@L["Admin.Reviews.ColAction"]" Class="os-table__end">
                    <div class="os-table__actions">
                        <OsIconButton Icon="@Icons.Material.Outlined.Check"
                                      Size="OsIconButton.IconButtonSize.Sm"
                                      Disabled="@(context.Status == "Approved")"
                                      OnClick="@(() => ApproveAsync(context))"
                                      AriaLabel="@L["Admin.ApproveReviewAria"]" />
                        <OsIconButton Icon="@Icons.Material.Outlined.Block"
                                      Size="OsIconButton.IconButtonSize.Sm"
                                      Disabled="@(context.Status == "Rejected")"
                                      OnClick="@(() => RejectAsync(context))"
                                      AriaLabel="@L["Admin.RejectReviewAria"]" />
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="@L["Admin.Table.RowsPerPage"]" />
            </PagerContent>
        </MudTable>
    </ChildContent>
</AdminListShell>

@code {
    private List<ReviewDto> _reviews = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var r = await AdminCatalog.GetReviewsAsync();
            if (r.IsSuccess) _reviews = r.Value!;
            else Snackbar.ShowApiError(r.Error);
        }
        catch (Exception ex) { Snackbar.ShowError(L["Common.Error", ex.Message]); }
        finally { _loading = false; }
    }

    private Task ApproveAsync(ReviewDto review) => ModerateAsync(review, approve: true);

    // Rejecting hides a customer's words for good, so it asks first; approving does not.
    private async Task RejectAsync(ReviewDto review)
    {
        var confirmed = await ConfirmDialog.ShowAsync(
            Dialogs,
            L["Admin.Confirm.RejectReviewTitle"],
            L["Admin.Confirm.RejectReviewBody"],
            L["Admin.Reviews.Reject"],
            danger: true);

        if (confirmed)
            await ModerateAsync(review, approve: false);
    }

    private async Task ModerateAsync(ReviewDto review, bool approve)
    {
        var result = await AdminCatalog.ModerateReviewAsync(review.Id, approve);
        if (result.IsSuccess)
        {
            Snackbar.ShowSuccess(approve ? L["Admin.Reviews.Approved"] : L["Admin.Reviews.Rejected"]);
            await LoadAsync();
        }
        else
        {
            Snackbar.ShowApiError(result.Error);
        }
    }
}
