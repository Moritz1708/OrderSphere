@page "/admin/orders"
@inject IAdminOrderingClient AdminOrdering
@inject ISnackbar Snackbar
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Admin.Orders.PageTitle"]</PageTitle>

<AdminListShell Eyebrow="@L["Admin.Nav.Section"]"
                Title="@L["Admin.Orders.Title"]"
                Subtitle="@L["Admin.Orders.Subtitle"]"
                Loading="_loading"
                IsEmpty="@(_orders.Count == 0)"
                EmptyIcon="@Icons.Material.Outlined.Inbox"
                EmptyTitle="@L["Admin.Orders.None"]">
    <Filters>
        <MudSelect T="string?" Value="_statusFilter" ValueChanged="OnStatusFilterChanged"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                   Clearable="true" Placeholder="@L["Admin.Orders.StatusFilter"]"
                   Class="pg-admin__filter">
            <MudSelectItem Value="@((string?)"Created")">@L[StatusPresentation.OrderLabelKey("Created")]</MudSelectItem>
            <MudSelectItem Value="@((string?)"Paid")">@L[StatusPresentation.OrderLabelKey("Paid")]</MudSelectItem>
            <MudSelectItem Value="@((string?)"Shipped")">@L[StatusPresentation.OrderLabelKey("Shipped")]</MudSelectItem>
            <MudSelectItem Value="@((string?)"Delivered")">@L[StatusPresentation.OrderLabelKey("Delivered")]</MudSelectItem>
            <MudSelectItem Value="@((string?)"Cancelled")">@L[StatusPresentation.OrderLabelKey("Cancelled")]</MudSelectItem>
        </MudSelect>
    </Filters>

    <ChildContent>
        <MudTable Items="_orders" Hover="true" Elevation="0" Class="os-table"
                  RowsPerPage="25" Breakpoint="Breakpoint.Md">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<OrderDto, object>(o => o.Id)">@L["Admin.Orders.ColOrder"]</MudTableSortLabel></MudTh>
                <MudTh>@L["Admin.Orders.ColCustomer"]</MudTh>
                <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<OrderDto, object>(o => o.CreatedAt)">@L["Admin.Orders.ColDate"]</MudTableSortLabel></MudTh>
                <MudTh>@L["Admin.Orders.ColTracking"]</MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<OrderDto, object>(o => o.Status)">@L["Admin.Orders.ColStatus"]</MudTableSortLabel></MudTh>
                <MudTh Class="os-table__num"><MudTableSortLabel SortBy="new Func<OrderDto, object>(o => o.Total)">@L["Admin.Orders.ColTotal"]</MudTableSortLabel></MudTh>
                <MudTh Class="os-table__end">@L["Admin.Orders.ColAction"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Admin.Orders.ColOrder"]">
                    <span class="os-mono">#@context.Id.ToString("N")[..8].ToUpperInvariant()</span>
                </MudTd>
                <MudTd DataLabel="@L["Admin.Orders.ColCustomer"]">
                    <span class="os-table__strong">@context.ShippingAddress.FirstName @context.ShippingAddress.LastName</span>
                    <span class="os-table__sub">@context.ShippingAddress.City</span>
                </MudTd>
                <MudTd DataLabel="@L["Admin.Orders.ColDate"]">
                    <span class="os-mono">@Formatting.DateTime(context.CreatedAt.ToLocalTime())</span>
                </MudTd>
                <MudTd DataLabel="@L["Admin.Orders.ColTracking"]">
                    <span class="os-mono">@(context.TrackingNumber ?? "—")</span>
                </MudTd>
                <MudTd DataLabel="@L["Admin.Orders.ColStatus"]">
                    <OsStatusChip Tone="StatusPresentation.OrderTone(context.Status)"
                                  Text="@L[StatusPresentation.OrderLabelKey(context.Status)]"
                                  Size="OsStatusChip.ChipSize.Sm"
                                  Dot="true" />
                </MudTd>
                <MudTd DataLabel="@L["Admin.Orders.ColTotal"]" Class="os-table__num">
                    <OsPrice Value="context.Total" Size="OsPrice.PriceSize.Sm" />
                </MudTd>
                <MudTd DataLabel="@L["Admin.Orders.ColAction"]" Class="os-table__end">
                    <OsButton Href="@($"/admin/orders/{context.Id}")"
                              Variant="OsButton.ButtonVariant.Secondary"
                              Size="OsButton.ButtonSize.Sm">
                        @L["Common.Details"]
                    </OsButton>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="@L["Admin.Table.RowsPerPage"]" />
            </PagerContent>
        </MudTable>
    </ChildContent>
</AdminListShell>

@code {
    private List<OrderDto> _orders = [];
    private string? _statusFilter;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnStatusFilterChanged(string? value)
    {
        _statusFilter = value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await AdminOrdering.GetOrdersAsync(_statusFilter);
            if (result.IsSuccess)
                _orders = result.Value!;
            else
                Snackbar.ShowApiError(result.Error);
        }
        catch (Exception ex)
        {
            Snackbar.ShowError(L["Common.LoadError", ex.Message]);
        }
        finally
        {
            _loading = false;
        }
    }
}
