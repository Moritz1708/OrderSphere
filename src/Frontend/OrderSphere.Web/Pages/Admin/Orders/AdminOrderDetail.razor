@page "/admin/orders/{OrderId:guid}"
@inject IAdminOrderingClient AdminOrdering
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Admin.OrderDetail.PageTitle"]</PageTitle>

<OsPageHeader Eyebrow="@L["Admin.Nav.Section"]"
              Title="@Heading"
              Breadcrumbs="Crumbs"
              Size="OsDisplay.DisplaySize.D3"
              Padding="OsPageHeader.HeaderPadding.Sm">
    <Actions>
        @if (_order is not null)
        {
            <OsStatusChip Tone="StatusPresentation.OrderTone(_order.Status)"
                          Text="@L[StatusPresentation.OrderLabelKey(_order.Status)]"
                          Dot="true" />
        }
    </Actions>
</OsPageHeader>

<OsSection Padding="OsSection.SectionPadding.Sm" Width="OsSection.SectionWidth.Wide">
    @if (_loading)
    {
        <OsDetailSkeleton />
    }
    else if (_order is null)
    {
        <OsEmptyState Icon="@Icons.Material.Outlined.SearchOff"
                      Title="@L["Admin.OrderDetail.NotFound"]"
                      ActionText="@L["Admin.OrderDetail.BackToList"]"
                      ActionHref="/admin/orders" />
    }
    else
    {
        <div class="pg-order">
            <div class="pg-order__main os-stack">
                <OsCard Padding="OsCard.CardPadding.Lg">
                    <div class="os-card__head">
                        <div>
                            <OsEyebrow Text="@L["Admin.OrderDetail.Order"]" Tone="OsEyebrow.EyebrowTone.Muted" Rule="false" />
                            <div class="pg-order__number os-mono">#@ShortId</div>
                            <div class="pg-order__placed os-mono">@Formatting.DateTime(_order.CreatedAt.ToLocalTime())</div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_order.TrackingNumber))
                        {
                            <div class="pg-order__tracking">
                                <MudIcon Icon="@Icons.Material.Outlined.LocalShipping" Size="Size.Small" />
                                <span class="os-mono">@_order.TrackingNumber</span>
                            </div>
                        }
                    </div>
                </OsCard>

                <OsCard Padding="OsCard.CardPadding.Lg">
                    <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3">@L["Admin.OrderDetail.Items"]</OsDisplay>

                    <div class="os-rows">
                        @foreach (var line in _order.Items)
                        {
                            <div class="os-row" @key="line.ProductId">
                                <div class="os-row__main">
                                    <span class="os-row__title">@line.ProductName</span>
                                    <span class="os-row__meta os-mono">
                                        @line.Quantity × @Formatting.Currency(line.Price)
                                    </span>
                                </div>
                                <div class="os-row__end">
                                    <OsPrice Value="@(line.Price * line.Quantity)" Size="OsPrice.PriceSize.Sm" />
                                </div>
                            </div>
                        }
                    </div>

                    <dl class="os-kv pg-order__totals">
                        <div class="os-kv__row">
                            <dt class="os-kv__key">@L["OrderSummary.Subtotal"]</dt>
                            <dd class="os-kv__val os-num">@Formatting.Currency(Subtotal)</dd>
                        </div>
                        @if (_order.DiscountAmount > 0)
                        {
                            <div class="os-kv__row">
                                <dt class="os-kv__key">
                                    @L["OrderSummary.Discount"]
                                    @if (_order.CouponCode is { } couponCode)
                                    {
                                        <span class="os-mono">(@couponCode)</span>
                                    }
                                </dt>
                                <dd class="os-kv__val os-num os-tone-success">−@Formatting.Currency(_order.DiscountAmount)</dd>
                            </div>
                        }
                        <div class="os-kv__row">
                            <dt class="os-kv__key">@L["OrderSummary.Shipping"]</dt>
                            <dd class="os-kv__val os-num">
                                @(_order.ShippingCost > 0 ? Formatting.Currency(_order.ShippingCost) : L["OrderSummary.Free"])
                            </dd>
                        </div>
                        <div class="os-kv__row os-kv__row--total">
                            <dt class="os-kv__key">@L["Admin.OrderDetail.Total"]</dt>
                            <dd class="os-kv__val">@Formatting.Currency(_order.Total)</dd>
                        </div>
                    </dl>
                </OsCard>

                @if (_order.StatusHistory is { Count: > 0 } history)
                {
                    <OsCard Padding="OsCard.CardPadding.Lg">
                        <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3">@L["OrderDetail.Timeline"]</OsDisplay>
                        <ol class="pg-timeline">
                            @foreach (var (entry, index) in history.Select((e, i) => (e, i)))
                            {
                                <li class="pg-timeline__item @(index == history.Count - 1 ? "is-current" : null)">
                                    <span class="pg-timeline__dot os-tone-@StatusPresentation.OrderTone(entry.Status).ToString().ToLowerInvariant()" aria-hidden="true"></span>
                                    <span class="pg-timeline__label">@L[StatusPresentation.OrderLabelKey(entry.Status)]</span>
                                    <time class="pg-timeline__time os-mono" datetime="@entry.OccurredAt.ToString("o")">
                                        @Formatting.DateTime(entry.OccurredAt.ToLocalTime())
                                    </time>
                                </li>
                            }
                        </ol>
                    </OsCard>
                }

                <OsCard Padding="OsCard.CardPadding.Lg">
                    <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3">@L["Admin.OrderDetail.ShippingAddress"]</OsDisplay>
                    <address class="pg-order__address">
                        @_order.ShippingAddress.FirstName @_order.ShippingAddress.LastName<br />
                        @_order.ShippingAddress.Street<br />
                        @_order.ShippingAddress.PostalCode @_order.ShippingAddress.City<br />
                        @_order.ShippingAddress.Country
                    </address>
                </OsCard>
            </div>

            <aside class="pg-order__aside">
                <OsCard Padding="OsCard.CardPadding.Lg" Class="pg-admin__rail-card">
                    <OsEyebrow Text="@L["Admin.OrderDetail.Actions"]" />

                    <div class="pg-admin__actions">
                        <OsButton Variant="OsButton.ButtonVariant.Secondary" FullWidth="true"
                                  StartIcon="@Icons.Material.Outlined.LocalShipping"
                                  Disabled="@(_order.Status != "Paid" || _busy)"
                                  OnClick="MarkShippedAsync">
                            @L["Admin.OrderDetail.MarkShipped"]
                        </OsButton>
                        <OsButton Variant="OsButton.ButtonVariant.Secondary" FullWidth="true"
                                  StartIcon="@Icons.Material.Outlined.HomeWork"
                                  Disabled="@(_order.Status != "Shipped" || _busy)"
                                  OnClick="MarkDeliveredAsync">
                            @L["Admin.OrderDetail.MarkDelivered"]
                        </OsButton>
                        <OsButton Variant="OsButton.ButtonVariant.Danger" FullWidth="true"
                                  StartIcon="@Icons.Material.Outlined.Cancel"
                                  Disabled="@(_order.Status is "Delivered" or "Cancelled" || _busy)"
                                  OnClick="CancelAsync">
                            @L["Admin.OrderDetail.Cancel"]
                        </OsButton>
                    </div>

                    @if (_order.Status == "Cancelled")
                    {
                        <p class="pg-admin__note">@L["Admin.OrderDetail.CancelledNote"]</p>
                    }
                    else if (_order.Status == "Delivered")
                    {
                        <p class="pg-admin__note">@L["Admin.OrderDetail.DeliveredNote"]</p>
                    }
                </OsCard>
            </aside>
        </div>
    }
</OsSection>

@code {
    [Parameter] public Guid OrderId { get; set; }

    private OrderDto? _order;
    private bool _loading = true;
    private bool _busy;

    private string ShortId => OrderId.ToString("N")[..8].ToUpperInvariant();
    private string Heading => $"#{ShortId}";

    private IReadOnlyList<OsCrumb> Crumbs =>
    [
        new OsCrumb(L["Admin.Orders.Title"], "/admin/orders"),
        new OsCrumb(Heading),
    ];

    private decimal Subtotal => _order?.Items.Sum(i => i.Quantity * i.Price) ?? 0m;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var r = await AdminOrdering.GetOrderByIdAsync(OrderId);
            _order = r.Value;
            if (!r.IsSuccess) Snackbar.ShowApiError(r.Error);
        }
        catch (Exception ex) { Snackbar.ShowError(L["Common.Error", ex.Message]); }
        finally { _loading = false; }
    }

    private Task MarkShippedAsync() => UpdateStatusAsync(2);   // Shipped
    private Task MarkDeliveredAsync() => UpdateStatusAsync(3); // Delivered

    private async Task UpdateStatusAsync(int status)
    {
        _busy = true;
        try
        {
            var result = await AdminOrdering.UpdateStatusAsync(OrderId, status);
            if (result.IsSuccess)
            {
                Snackbar.ShowSuccess(L["Admin.OrderDetail.StatusUpdated"]);
                await LoadAsync();
            }
            else
            {
                Snackbar.ShowApiError(result.Error);
            }
        }
        finally { _busy = false; }
    }

    // Cancelling refunds and restocks; there is no undo, so it asks first.
    private async Task CancelAsync()
    {
        var confirmed = await ConfirmDialog.ShowAsync(
            Dialogs,
            L["Admin.Confirm.CancelOrderTitle"],
            L["Admin.Confirm.CancelOrderBody", ShortId],
            L["Admin.OrderDetail.Cancel"],
            danger: true);

        if (!confirmed) return;

        _busy = true;
        try
        {
            var result = await AdminOrdering.CancelOrderAsync(OrderId);
            if (result.IsSuccess)
            {
                Snackbar.ShowSuccess(L["Admin.OrderDetail.OrderCancelled"]);
                await LoadAsync();
            }
            else
            {
                Snackbar.ShowApiError(result.Error);
            }
        }
        finally { _busy = false; }
    }
}
