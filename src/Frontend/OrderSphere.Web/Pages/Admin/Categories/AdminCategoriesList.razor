@page "/admin/categories"
@inject IAdminCatalogClient AdminCatalog
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Admin.Categories.PageTitle"]</PageTitle>

<AdminListShell Eyebrow="@L["Admin.Nav.Section"]"
                Title="@L["Admin.Categories.Title"]"
                Subtitle="@L["Admin.Categories.Subtitle"]"
                Loading="_loading"
                IsEmpty="@(_categories.Count == 0)"
                EmptyIcon="@Icons.Material.Outlined.Category"
                EmptyTitle="@L["Admin.Categories.None"]"
                EmptyActionText="@L["Admin.Categories.New"]"
                EmptyActionHref="/admin/categories/new">
    <Actions>
        <OsButton Href="/admin/categories/new" StartIcon="@Icons.Material.Outlined.Add">
            @L["Admin.Categories.New"]
        </OsButton>
    </Actions>

    <ChildContent>
        <MudTable Items="_categories" Hover="true" Elevation="0" Class="os-table"
                  RowsPerPage="25" Breakpoint="Breakpoint.Md">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<AdminCategoryDto, object>(c => c.Name)">@L["Admin.Categories.ColName"]</MudTableSortLabel></MudTh>
                <MudTh>@L["Admin.Categories.ColDescription"]</MudTh>
                <MudTh Class="os-table__num"><MudTableSortLabel SortBy="new Func<AdminCategoryDto, object>(c => c.ProductCount)">@L["Admin.Categories.ColProducts"]</MudTableSortLabel></MudTh>
                <MudTh>@L["Admin.Categories.ColStatus"]</MudTh>
                <MudTh Class="os-table__end">@L["Admin.Categories.ColAction"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Admin.Categories.ColName"]"><span class="os-table__strong">@context.Name</span></MudTd>
                <MudTd DataLabel="@L["Admin.Categories.ColDescription"]">
                    <span class="os-table__sub">@context.Description</span>
                </MudTd>
                <MudTd DataLabel="@L["Admin.Categories.ColProducts"]" Class="os-table__num">
                    <span class="os-num">@context.ProductCount</span>
                </MudTd>
                <MudTd DataLabel="@L["Admin.Categories.ColStatus"]">
                    <OsStatusChip Tone="StatusPresentation.ActiveTone(context.IsActive)"
                                  Text="@(context.IsActive ? L["Common.Active"] : L["Common.Inactive"])"
                                  Size="OsStatusChip.ChipSize.Sm" />
                </MudTd>
                <MudTd DataLabel="@L["Admin.Categories.ColAction"]" Class="os-table__end">
                    <div class="os-table__actions">
                        <OsIconButton Icon="@Icons.Material.Outlined.Edit"
                                      Size="OsIconButton.IconButtonSize.Sm"
                                      Href="@($"/admin/categories/{context.Id}")"
                                      AriaLabel="@L["Admin.EditCategoryAria"]" />
                        <OsIconButton Icon="@Icons.Material.Outlined.Delete"
                                      Size="OsIconButton.IconButtonSize.Sm"
                                      Disabled="@(context.ProductCount > 0)"
                                      OnClick="@(() => DeleteAsync(context.Id, context.Name))"
                                      AriaLabel="@L["Admin.DeleteCategoryAria"]" />
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="@L["Admin.Table.RowsPerPage"]" />
            </PagerContent>
        </MudTable>
    </ChildContent>
</AdminListShell>

@code {
    private List<AdminCategoryDto> _categories = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var r = await AdminCatalog.GetCategoriesAsync();
            if (r.IsSuccess) _categories = r.Value!;
            else Snackbar.ShowApiError(r.Error);
        }
        catch (Exception ex) { Snackbar.ShowError(L["Common.Error", ex.Message]); }
        finally { _loading = false; }
    }

    private async Task DeleteAsync(Guid id, string name)
    {
        var confirmed = await ConfirmDialog.ShowAsync(
            Dialogs,
            L["Admin.Confirm.DeleteCategoryTitle"],
            L["Admin.Confirm.DeleteCategoryBody", name],
            L["Common.Delete"],
            danger: true);

        if (!confirmed) return;

        var result = await AdminCatalog.DeleteCategoryAsync(id);
        if (result.IsSuccess)
        {
            _categories.RemoveAll(c => c.Id == id);
            Snackbar.ShowSuccess(L["Admin.Categories.Deleted"]);
        }
        else
        {
            Snackbar.ShowApiError(result.Error);
        }
    }
}
