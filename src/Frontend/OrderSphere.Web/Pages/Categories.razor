@page "/categories"
@inject ICatalogClient Catalog
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Categories.PageTitle"]</PageTitle>

<OsPageHeader Eyebrow="@L["Categories.HeroEyebrow"]"
              Title="@L["Nav.Categories"]"
              Subtitle="@L["Categories.HeroSubtitle"]" />

<OsSection Padding="OsSection.SectionPadding.Sm">
    @if (_loading)
    {
        <OsProductCardSkeleton Count="6" />
    }
    else if (_error is not null)
    {
        <OsErrorState Message="@_error" OnRetry="LoadCategoriesAsync" />
    }
    else if (_categories.Count == 0)
    {
        <OsEmptyState Icon="@Icons.Material.Outlined.Category" Title="@L["Categories.None"]" />
    }
    else
    {
        <div class="pg-categories__grid">
            @foreach (var category in _categories)
            {
                <OsCard @key="category.Id"
                        Href="@($"/shop/category/{Uri.EscapeDataString(category.Name)}")"
                        Padding="OsCard.CardPadding.Lg"
                        Class="pg-categories__tile">
                    <MudIcon Icon="@GetCategoryIcon(category.Name)" Class="pg-categories__icon" />
                    <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3">@category.Name</OsDisplay>
                    @if (!string.IsNullOrWhiteSpace(category.Description))
                    {
                        <p class="pg-categories__desc">@category.Description</p>
                    }
                    <OsStatusChip Tone="StatusTone.Neutral"
                                  Text="@($"{category.ProductCount} {(category.ProductCount == 1 ? L["Categories.ProductSingular"] : L["Categories.ProductPlural"])}")"
                                  Class="mt-auto" />
                </OsCard>
            }
        </div>
    }
</OsSection>

@code {
    private List<CategoryDto> _categories = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadCategoriesAsync();

    private async Task LoadCategoriesAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var res = await Catalog.GetCategoriesAsync();
            if (res.IsSuccess)
                _categories = res.Value!.Items.ToList();
            else
                _error = res.Error?.Message ?? L["Common.LoadError"];
        }
        catch (Exception ex)
        {
            _error = L["Categories.LoadError", ex.Message];
        }
        finally
        {
            _loading = false;
        }
    }

    private static string GetCategoryIcon(string name) => name.ToLowerInvariant() switch
    {
        var n when n.Contains("laptop") => Icons.Material.Outlined.Laptop,
        var n when n.Contains("phone") || n.Contains("smartphone") => Icons.Material.Outlined.PhoneIphone,
        var n when n.Contains("tablet") => Icons.Material.Outlined.Tablet,
        var n when n.Contains("zubehör") || n.Contains("accessor") => Icons.Material.Outlined.Headphones,
        var n when n.Contains("audio") => Icons.Material.Outlined.Speaker,
        var n when n.Contains("monitor") || n.Contains("display") => Icons.Material.Outlined.Monitor,
        var n when n.Contains("kamera") || n.Contains("camera") => Icons.Material.Outlined.PhotoCamera,
        _ => Icons.Material.Outlined.Devices
    };
}
