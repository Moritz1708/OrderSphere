@page "/"
@inject ICatalogClient Catalog
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L

<PageTitle>OrderSphere</PageTitle>

@* ---- Masthead: stays dark in both themes (--os-block) ---- *@
<OsSection Tone="OsSection.SectionTone.Block" Padding="OsSection.SectionPadding.Lg" Class="pg-home-hero">
    <div class="pg-home-hero__grid">
        <div class="pg-home-hero__copy">
            <OsEyebrow Text="@L["Home.HeroEyebrow"]" Tone="OsEyebrow.EyebrowTone.OnBlock" />
            <OsDisplay As="h1" Size="OsDisplay.DisplaySize.D1" Class="mt-3">@((MarkupString)L["Home.HeroTitleHtml"].Value)</OsDisplay>
            <p class="pg-home-hero__lede">@L["Home.HeroSubtitle"]</p>
            <div class="pg-home-hero__actions">
                <OsButton Href="/shop" Size="OsButton.ButtonSize.Lg" EndIcon="@Icons.Material.Outlined.ArrowForward">@L["Cart.ToShop"]</OsButton>
                <OsButton Href="/categories" Variant="OsButton.ButtonVariant.Secondary" Size="OsButton.ButtonSize.Lg" Class="pg-home-hero__ghost">
                    @L["Nav.Categories"]
                </OsButton>
            </div>
        </div>

        <aside class="pg-home-issue" aria-label="@L["Home.IssueTitle"]">
            <OsEyebrow Text="@L["Home.IssueTitle"]" Tone="OsEyebrow.EyebrowTone.OnBlock" />
            <dl class="pg-home-issue__rows">
                <div class="pg-home-issue__row">
                    <dt class="pg-home-issue__k">01</dt>
                    <dd class="pg-home-issue__v">@L["Home.FreeShipping"]</dd>
                </div>
                <div class="pg-home-issue__row">
                    <dt class="pg-home-issue__k">02</dt>
                    <dd class="pg-home-issue__v">@L["Home.Returns"]</dd>
                </div>
                <div class="pg-home-issue__row">
                    <dt class="pg-home-issue__k">03</dt>
                    <dd class="pg-home-issue__v">@L["Home.Warranty"]</dd>
                </div>
                <div class="pg-home-issue__row">
                    <dt class="pg-home-issue__k">04</dt>
                    <dd class="pg-home-issue__v os-num">@(_totalProducts is { } n ? L["Home.ProductCount", n] : L["Home.CuratedRange"])</dd>
                </div>
            </dl>
        </aside>
    </div>
</OsSection>

@* ---- Bento: the five largest categories, live ---- *@
<OsSection Tone="OsSection.SectionTone.Paper">
    <div class="pg-home-head">
        <div>
            <OsEyebrow Text="@L["Home.CategoriesEyebrow"]" />
            <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D2" Class="mt-2">@L["Home.WhatLookingFor"]</OsDisplay>
        </div>
        <OsButton Href="/categories" Variant="OsButton.ButtonVariant.Ghost" EndIcon="@Icons.Material.Outlined.ArrowForward">
            @L["Home.ViewAll"]
        </OsButton>
    </div>

    @if (_categoriesError is not null)
    {
        <OsErrorState Message="@_categoriesError" OnRetry="LoadAsync" />
    }
    else if (_categories is null)
    {
        <OsSkeletonGroup Class="pg-home-bento">
            @foreach (var _ in Enumerable.Range(0, 5))
            {
                <OsSkeleton Variant="OsSkeleton.SkeletonVariant.Rect" Class="pg-home-bento__skeleton" />
            }
        </OsSkeletonGroup>
    }
    else if (_categories.Count == 0)
    {
        <OsEmptyState Icon="@Icons.Material.Outlined.Category" Title="@L["Categories.None"]" Compact="true" />
    }
    else
    {
        <OsRevealGroup Class="pg-home-bento">
            @foreach (var category in _categories)
            {
                <OsCard @key="category.Id"
                        Href="@($"/shop/category/{Uri.EscapeDataString(category.Name)}")"
                        Padding="OsCard.CardPadding.None"
                        Class="pg-home-bento__tile">
                    <OsProductImage Seed="category.Id" Initial="@category.Name" Name="@category.Name" Ratio="16/10" Class="pg-home-bento__media" />
                    <div class="pg-home-bento__body">
                        <OsDisplay As="h3" Size="OsDisplay.DisplaySize.D3">@category.Name</OsDisplay>
                        <span class="pg-home-bento__count os-mono">@L["Home.ProductCount", category.ProductCount]</span>
                    </div>
                </OsCard>
            }
        </OsRevealGroup>
    }
</OsSection>

@* ---- Featured rail: newest products, horizontally scrollable ---- *@
<OsSection>
    <div class="pg-home-head">
        <div>
            <OsEyebrow Text="@L["Home.FeaturedEyebrow"]" />
            <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D2" Class="mt-2">@L["Home.FeaturedTitle"]</OsDisplay>
        </div>
        <OsButton Href="/shop" Variant="OsButton.ButtonVariant.Ghost" EndIcon="@Icons.Material.Outlined.ArrowForward">
            @L["Common.AllProducts"]
        </OsButton>
    </div>

    @if (_featuredError is not null)
    {
        <OsErrorState Message="@_featuredError" OnRetry="LoadAsync" />
    }
    else if (_featured is null)
    {
        <OsProductCardSkeleton Count="4" />
    }
    else if (_featured.Count > 0)
    {
        <div class="pg-home-rail" role="list" aria-label="@L["Home.FeaturedTitle"]">
            @foreach (var product in _featured)
            {
                <div role="listitem" class="pg-home-rail__item" @key="product.Id">
                    <ProductCard Product="product" ShowCategory="true" OnOpen="OpenDetails" OnAdd="AddToCartAsync" />
                </div>
            }
        </div>
    }
</OsSection>

@* ---- Promise: the editorial statement ---- *@
<OsSection Tone="OsSection.SectionTone.Sunk" Padding="OsSection.SectionPadding.Lg">
    <div class="pg-home-promise">
        <div class="pg-home-promise__col">
            <OsEyebrow Text="@L["Home.PromiseEyebrow"]" />
            <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D2" Class="mt-3">@((MarkupString)L["Home.PromiseTitle"].Value)</OsDisplay>
            <p class="pg-home-promise__body">@L["Home.PromiseBody"]</p>
        </div>
        <figure class="pg-home-promise__col pg-home-promise__quote">
            <blockquote class="pg-home-promise__text">@L["Home.Quote"]</blockquote>
            <figcaption class="pg-home-promise__cite">
                <span class="pg-home-promise__mark" aria-hidden="true">○</span>
                <span>
                    <strong>OrderSphere Team</strong>
                    <span class="os-muted pg-home-promise__role">@L["Home.TeamRole"]</span>
                </span>
            </figcaption>
        </figure>
    </div>
</OsSection>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<CategoryDto>? _categories;
    private string? _categoriesError;
    private List<ProductDto>? _featured;
    private string? _featuredError;
    private int? _totalProducts;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _categoriesError = null;
        _featuredError = null;

        // Both calls are independent; run them together so the page settles in one round trip.
        var categoriesTask = Catalog.GetCategoriesAsync();
        var featuredTask = Catalog.GetProductsAsync(new ProductQuery(Page: 1, PageSize: 8, SortBy: "newest", SortDir: "desc"));
        await Task.WhenAll(categoriesTask, featuredTask);

        var categories = await categoriesTask;
        if (categories.IsSuccess)
        {
            _categories = categories.Value!.Items
                .OrderByDescending(c => c.ProductCount)
                .ThenBy(c => c.Name)
                .Take(5)
                .ToList();
        }
        else
        {
            _categoriesError = categories.Error?.Message ?? L["Common.LoadError"];
        }

        var featured = await featuredTask;
        if (featured.IsSuccess)
        {
            _featured = featured.Value!.Items.ToList();
            _totalProducts = featured.Value.TotalCount;
        }
        else
        {
            _featuredError = featured.Error?.Message ?? L["Common.LoadError"];
        }
    }

    private void OpenDetails(ProductDto product)
        => Navigation.NavigateTo($"/shop/{Uri.EscapeDataString(product.CategoryName)}/{Uri.EscapeDataString(product.Slug)}");

    private async Task AddToCartAsync(ProductDto product)
    {
        if (!await LoginRedirect.EnsureSignedInAsync(AuthState, Navigation))
            return;

        await AddToCartDialog.ShowAsync(Dialogs, product);
    }
}
