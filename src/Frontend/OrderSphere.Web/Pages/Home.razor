@page "/"
@inject IStringLocalizer<AppStrings> L

<PageTitle>OrderSphere</PageTitle>

@* Masthead. Stays dark in both themes (--os-block). The editorial bento and the
   featured rail arrive with the storefront redesign; this is the shell of it. *@
<OsSection Tone="OsSection.SectionTone.Block" Padding="OsSection.SectionPadding.Lg" Class="pg-home-hero">
    <div class="os-split os-split--xl">
        <div class="pg-home-hero__copy">
            <OsEyebrow Text="@L["Home.HeroEyebrow"]" Tone="OsEyebrow.EyebrowTone.OnBlock" />
            <OsDisplay As="h1" Size="OsDisplay.DisplaySize.D1" Class="mt-3">@L["Home.HeroTitle"]</OsDisplay>
            <p class="pg-home-hero__lede">@L["Home.HeroSubtitle"]</p>

            <div class="pg-home-hero__actions">
                <OsButton Href="/shop" Size="OsButton.ButtonSize.Lg">@L["Cart.ToShop"]</OsButton>
                <OsButton Href="/categories" Variant="OsButton.ButtonVariant.Secondary" Size="OsButton.ButtonSize.Lg" Class="pg-home-hero__ghost">
                    @L["Nav.Categories"]
                </OsButton>
            </div>

            <ul class="pg-home-hero__trust os-mono">
                <li>@L["Home.FreeShipping"]</li>
                <li>@L["Home.Returns"]</li>
                <li>@L["Home.Warranty"]</li>
            </ul>
        </div>

        <div class="pg-home-hero__visual" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Outlined.Laptop" Class="pg-home-hero__icon" />
        </div>
    </div>
</OsSection>

<!-- CATEGORY STRIP -->
<section class="section-white">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:40px;">
            <div>
                <span class="os-eyebrow">@L["Home.CategoriesEyebrow"]</span>
                <MudText Typo="Typo.h3" Style="margin-top:8px;letter-spacing:-0.015em;">
                    @L["Home.WhatLookingFor"]
                </MudText>
            </div>
            <OsButton Href="/shop" Variant="OsButton.ButtonVariant.Ghost" EndIcon="@Icons.Material.Outlined.ArrowForward">
                @L["Common.AllProducts"]
            </OsButton>
        </div>

        <MudGrid Spacing="3">
            @foreach (var cat in _categories)
            {
                <MudItem xs="6" sm="3">
                    <MudPaper Elevation="0" Class="product-card pa-6 text-center" Style="cursor:default;" tabindex="-1">
                        <MudIcon Icon="@cat.Icon" Color="Color.Primary" Style="font-size:40px;" />
                        <MudText Typo="Typo.body1" Style="font-weight:600;margin-top:12px;">@cat.Name</MudText>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </MudContainer>
</section>

<!-- EDITORIAL -->
<section class="section-gray">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="os-split os-split--xl">
            <div>
                <span class="os-eyebrow">@L["Home.PromiseEyebrow"]</span>
                <MudText Typo="Typo.h2" Style="margin-top:16px;letter-spacing:-0.025em;line-height:1.1;">
                    @((MarkupString)L["Home.PromiseTitle"].Value)
                </MudText>
                <MudText Typo="Typo.body1" Class="text-muted" Style="margin-top:20px;line-height:1.7;">
                    @L["Home.PromiseBody"]
                </MudText>
            </div>
            <div>
                <OsCard Padding="OsCard.CardPadding.Lg">
                    <MudText Typo="Typo.h5" Style="font-style:italic;line-height:1.5;font-weight:400;">
                        @L["Home.Quote"]
                    </MudText>
                    <MudDivider Class="my-4" />
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <span class="icon-bubble-primary" style="width:36px;height:36px;">
                            <MudIcon Icon="@Icons.Material.Outlined.Person" Style="font-size:18px;" />
                        </span>
                        <div>
                            <MudText Typo="Typo.body2" Style="font-weight:600;">OrderSphere Team</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">@L["Home.TeamRole"]</MudText>
                        </div>
                    </MudStack>
                </OsCard>
            </div>
        </div>
    </MudContainer>
</section>

@code {
    private List<(string Icon, string Name)> _categories = [];

    protected override void OnInitialized() =>
        _categories =
        [
            (Icons.Material.Outlined.Laptop, L["Home.CatLaptops"]),
            (Icons.Material.Outlined.PhoneIphone, L["Home.CatSmartphones"]),
            (Icons.Material.Outlined.Tablet, L["Home.CatTablets"]),
            (Icons.Material.Outlined.Headphones, L["Home.CatAccessories"]),
        ];
}
