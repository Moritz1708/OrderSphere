@page "/onboarding"
@attribute [Authorize]
@inject IUserProfileClient UserProfile
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IMotionService Motion
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Onboarding.PageTitle"]</PageTitle>

<OsPageHeader Title="@L["Onboarding.DisplayName"]" Subtitle="@L["Onboarding.HeroSubtitle"]" Narrow="true" />

<OsSection Padding="OsSection.SectionPadding.Sm" Width="OsSection.SectionWidth.Narrow">
    @if (_loading)
    {
        <OsListSkeleton Rows="2" />
    }
    else
    {
        <div class="pg-checkout__steps pg-onboarding">
            <section class="pg-step" aria-labelledby="ob-name">
                <span class="pg-step__num os-mono" aria-hidden="true">01</span>
                <div class="pg-step__body">
                    <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3" id="ob-name">@L["Onboarding.DisplayName"]</OsDisplay>
                    <p class="pg-step__hint">@L["Onboarding.DisplayNameHint"]</p>
                    <MudForm @ref="_nameForm">
                        <MudTextField T="string" @bind-Value="_displayName"
                                      Label="@L["Onboarding.DisplayNameLabel"]"
                                      Variant="Variant.Outlined" ShrinkLabel="true"
                                      Required="true" RequiredError="@L["Validation.Required"]"
                                      autocomplete="nickname" />
                    </MudForm>
                </div>
            </section>

            <section class="pg-step" aria-labelledby="ob-address">
                <span class="pg-step__num os-mono" aria-hidden="true">02</span>
                <div class="pg-step__body">
                    <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3" id="ob-address">@L["Onboarding.FirstAddress"]</OsDisplay>
                    <p class="pg-step__hint">@L["Onboarding.FirstAddressHint"]</p>
                    <AddressForm @ref="_addressForm" Model="_address" />
                </div>
            </section>

            @* Sticky on a phone so the way forward is always one tap away. *@
            <div class="os-actionbar">
                <OsButton Size="OsButton.ButtonSize.Lg" FullWidth="true" Loading="_saving" OnClick="SubmitAsync">
                    @L["Onboarding.Submit"]
                </OsButton>
            </div>
        </div>
    }
</OsSection>

@code {
    private bool _loading = true;
    private bool _saving;
    private string _displayName = string.Empty;

    private MudForm _nameForm = default!;
    private AddressForm _addressForm = default!;
    private readonly AddressFormModel _address = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = (await UserProfile.GetOrCreateProfileAsync()).Value;
            if (profile is not null)
            {
                _displayName = profile.DisplayName;

                // Already onboarded — redirect away.
                if (profile.IsOnboardingComplete)
                {
                    Nav.NavigateTo("/");
                    return;
                }
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SubmitAsync()
    {
        await _nameForm.ValidateAsync();
        if (!_nameForm.IsValid)
        {
            await Motion.FocusFirstInvalidAsync();
            return;
        }

        // The address is optional, but once the user has started one it has to be complete.
        if (_address.IsTouched && !await _addressForm.ValidateAsync())
            return;

        _saving = true;
        try
        {
            var profileResult = await UserProfile.UpdateProfileAsync(new UpdateProfileRequest(_displayName, string.Empty));
            if (!profileResult.IsSuccess)
            {
                Snackbar.ShowApiError(profileResult.Error);
                return;
            }

            if (_address.IsComplete)
            {
                var addressResult = await UserProfile.AddAddressAsync(
                    _address.ToCreateAddressRequest(label: "Standard", setAsDefault: true));
                if (!addressResult.IsSuccess)
                {
                    Snackbar.ShowApiError(addressResult.Error);
                    return;
                }
            }

            var result = await UserProfile.CompleteOnboardingAsync();
            if (!result.IsSuccess)
            {
                Snackbar.ShowError(L["Onboarding.OnboardingError"]);
                return;
            }

            Nav.NavigateTo("/");
        }
        catch
        {
            Snackbar.ShowError(L["Onboarding.Error"]);
        }
        finally
        {
            _saving = false;
        }
    }
}
