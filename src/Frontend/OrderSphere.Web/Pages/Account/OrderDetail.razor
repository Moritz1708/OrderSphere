@page "/account/orders/{OrderId:guid}"
@attribute [Authorize]
@inject IOrderingClient Ordering
@inject IInvoicingClient Invoicing
@inject ISnackbar Snackbar
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["OrderDetail.PageTitle"]</PageTitle>

@if (_loading)
{
    <OsSection Padding="OsSection.SectionPadding.Sm">
        <OsDetailSkeleton />
    </OsSection>
}
else if (_order is null)
{
    <OsSection Width="OsSection.SectionWidth.Narrow">
        <OsEmptyState Icon="@Icons.Material.Outlined.ReceiptLong"
                      Title="@L["OrderDetail.NotFound"]"
                      ActionText="@L["Common.Back"]"
                      ActionHref="/account/orders" />
    </OsSection>
}
else
{
    <OsPageHeader Breadcrumbs="Crumbs"
                  Eyebrow="@L["Orders.OrderNumber"]"
                  Title="@($"#{ShortId}")"
                  Size="OsDisplay.DisplaySize.D3"
                  Padding="OsPageHeader.HeaderPadding.Sm">
        <Actions>
            <OsStatusChip Tone="StatusPresentation.OrderTone(_order.Status)"
                          Text="@L[StatusPresentation.OrderLabelKey(_order.Status)]"
                          Dot="true" />
        </Actions>
    </OsPageHeader>

    <OsSection Padding="OsSection.SectionPadding.Sm">
        <div class="pg-order">
            <div class="pg-order__main">
                <OsCard Padding="OsCard.CardPadding.Lg">
                    <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3" Class="mb-4">@L["OrderDetail.Items"]</OsDisplay>

                    <div class="os-rows">
                        @foreach (var line in _order.Items)
                        {
                            <div class="os-row">
                                <div class="os-row__main">
                                    <span class="os-row__title">@line.ProductName</span>
                                    <span class="os-row__meta os-num">@line.Quantity × @Formatting.Currency(line.Price)</span>
                                </div>
                                <OsPrice Value="line.Quantity * line.Price" />
                            </div>
                        }
                    </div>

                    <dl class="os-kv mt-5">
                        <div class="os-kv__row">
                            <dt class="os-kv__key">@L["OrderSummary.Subtotal"]</dt>
                            <dd class="os-kv__val">@Formatting.Currency(Subtotal)</dd>
                        </div>
                        @if (_order.DiscountAmount > 0)
                        {
                            <div class="os-kv__row">
                                <dt class="os-kv__key">@L["OrderSummary.Discount"] @(_order.CouponCode is { } c ? $"({c})" : "")</dt>
                                <dd class="os-kv__val os-kv__val--positive">−@Formatting.Currency(_order.DiscountAmount)</dd>
                            </div>
                        }
                        <div class="os-kv__row">
                            <dt class="os-kv__key">@L["OrderSummary.Shipping"]</dt>
                            @if (_order.ShippingCost > 0)
                            {
                                <dd class="os-kv__val">@Formatting.Currency(_order.ShippingCost)</dd>
                            }
                            else
                            {
                                <dd class="os-kv__val os-kv__val--positive">@L["OrderSummary.Free"]</dd>
                            }
                        </div>
                        <div class="os-kv__row os-kv__row--total">
                            <dt class="os-kv__key">@L["OrderDetail.Total"]</dt>
                            <dd class="os-kv__val">@Formatting.Currency(_order.Total)</dd>
                        </div>
                    </dl>
                </OsCard>

                @if (_order.StatusHistory is { Count: > 0 } history)
                {
                    <OsCard Padding="OsCard.CardPadding.Lg" Class="mt-4">
                        <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3" Class="mb-4">@L["OrderDetail.Timeline"]</OsDisplay>
                        @* An editorial rail rather than MudTimeline: one hairline, a dot
                           per step, mono timestamps. The newest entry is the emphasised one. *@
                        <ol class="pg-timeline">
                            @foreach (var (entry, index) in history.Select((e, i) => (e, i)))
                            {
                                <li class="pg-timeline__item @(index == history.Count - 1 ? "is-current" : null)">
                                    <span class="pg-timeline__dot os-tone-@StatusPresentation.OrderTone(entry.Status).ToString().ToLowerInvariant()" aria-hidden="true"></span>
                                    <span class="pg-timeline__label">@L[StatusPresentation.OrderLabelKey(entry.Status)]</span>
                                    <time class="pg-timeline__time os-mono" datetime="@entry.OccurredAt.ToString("o")">
                                        @Formatting.DateTime(entry.OccurredAt.ToLocalTime())
                                    </time>
                                </li>
                            }
                        </ol>
                    </OsCard>
                }
            </div>

            <aside class="pg-order__aside">
                <OsCard>
                    <h2 class="os-card__label"><OsEyebrow Text="@L["OrderDetail.ShippingAddress"]" Tone="OsEyebrow.EyebrowTone.Muted" Rule="false" /></h2>
                    <address class="pg-order__address">
                        @_order.ShippingAddress.FirstName @_order.ShippingAddress.LastName<br />
                        @_order.ShippingAddress.Street<br />
                        @_order.ShippingAddress.PostalCode @_order.ShippingAddress.City<br />
                        @_order.ShippingAddress.Country
                    </address>
                </OsCard>

                @if (!string.IsNullOrWhiteSpace(_order.TrackingNumber))
                {
                    <OsCard>
                        <h2 class="os-card__label"><OsEyebrow Text="@L["OrderDetail.Tracking"]" Tone="OsEyebrow.EyebrowTone.Muted" Rule="false" /></h2>
                        <span class="pg-order__tracking os-mono">
                            <MudIcon Icon="@Icons.Material.Outlined.LocalShipping" Size="Size.Small" />
                            @_order.TrackingNumber
                        </span>
                    </OsCard>
                }

                <OsCard>
                    <h2 class="os-card__label"><OsEyebrow Text="@L["OrderDetail.Details"]" Tone="OsEyebrow.EyebrowTone.Muted" Rule="false" /></h2>
                    <dl class="os-kv">
                        <div class="os-kv__row">
                            <dt class="os-kv__key">@L["OrderDetail.OrderDate"]</dt>
                            <dd class="os-kv__val">@Formatting.DateTime(_order.CreatedAt.ToLocalTime())</dd>
                        </div>
                    </dl>
                </OsCard>

                <OsCard>
                    <h2 class="os-card__label"><OsEyebrow Text="@L["OrderDetail.Invoice"]" Tone="OsEyebrow.EyebrowTone.Muted" Rule="false" /></h2>
                    @if (_invoice is not null)
                    {
                        <dl class="os-kv mb-4">
                            <div class="os-kv__row">
                                <dt class="os-kv__key">@L["OrderDetail.InvoiceNumber"]</dt>
                                <dd class="os-kv__val">@_invoice.InvoiceNumber</dd>
                            </div>
                        </dl>
                        <OsButton Href="@Invoicing.GetPdfUrl(_order.Id)" Target="_blank" FullWidth="true"
                                  StartIcon="@Icons.Material.Outlined.PictureAsPdf">
                            @L["OrderDetail.ViewInvoice"]
                        </OsButton>
                        <OsButton Href="@Invoicing.GetDownloadUrl(_order.Id)" FullWidth="true"
                                  Variant="OsButton.ButtonVariant.Secondary"
                                  StartIcon="@Icons.Material.Outlined.Download"
                                  Class="mt-2">
                            @L["OrderDetail.DownloadInvoice"]
                        </OsButton>
                    }
                    else
                    {
                        <p class="os-muted">@L["OrderDetail.InvoicePending"]</p>
                    }
                </OsCard>
                </aside>
        </div>
    </OsSection>
}

@code {
    [Parameter] public Guid OrderId { get; set; }

    private OrderDto? _order;
    private InvoiceDto? _invoice;
    private bool _loading = true;

    private decimal Subtotal => _order?.Items.Sum(i => i.Quantity * i.Price) ?? 0m;
    private string ShortId => OrderId.ToString("N")[..8].ToUpperInvariant();

    private IReadOnlyList<OsCrumb> Crumbs =>
    [
        new(L["Account.MyOrders"], "/account/orders"),
        new($"#{ShortId}"),
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Ordering.GetOrderByIdAsync(OrderId);
            _order = result.Value;
            if (!result.IsSuccess)
            {
                Snackbar.ShowApiError(result.Error);
                return;
            }

            // The invoice is generated asynchronously after checkout; a not-found result simply
            // means it is not ready yet, so the card shows a pending note rather than an error.
            var invoiceResult = await Invoicing.GetByOrderAsync(OrderId);
            if (invoiceResult.IsSuccess)
                _invoice = invoiceResult.Value;
        }
        finally
        {
            _loading = false;
        }
    }
}
