@page "/account/profile"
@attribute [Authorize]
@inject IUserProfileClient UserProfile
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Profile.PageTitle"]</PageTitle>

<OsPageHeader Title="@L["Account.MyProfile"]" Subtitle="@L["Profile.HeroSubtitle"]" Narrow="true" />

<OsSection Padding="OsSection.SectionPadding.Sm" Width="OsSection.SectionWidth.Narrow">
    @if (_loading)
    {
        <OsListSkeleton Rows="3" />
    }
    else if (_profile is not null)
    {
        <MudStack Spacing="4">
            <OsCard Padding="OsCard.CardPadding.Lg">
                <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3" Class="mb-5">@L["Profile.PersonalData"]</OsDisplay>
                <div class="os-form-grid">
                    <MudTextField T="string" @bind-Value="_displayName"
                                  Label="@L["Profile.DisplayName"]"
                                  Variant="Variant.Outlined" ShrinkLabel="true" />
                    <MudTextField T="string" @bind-Value="_email"
                                  Label="@L["Address.Email"]"
                                  Variant="Variant.Outlined" ShrinkLabel="true"
                                  InputType="InputType.Email" />
                </div>
                <OsButton OnClick="SaveProfileAsync" Loading="_saving" Class="mt-5">
                    @L["Common.Save"]
                </OsButton>
            </OsCard>

            <OsCard Padding="OsCard.CardPadding.Lg">
                <div class="os-card__head">
                    <OsDisplay As="h2" Size="OsDisplay.DisplaySize.D3">@L["Profile.Addresses"]</OsDisplay>
                    <OsButton Variant="OsButton.ButtonVariant.Secondary"
                              Size="OsButton.ButtonSize.Sm"
                              StartIcon="@Icons.Material.Outlined.Add"
                              OnClick="() => _showAddAddress = !_showAddAddress">
                        @L["Common.Add"]
                    </OsButton>
                </div>

                @if (_showAddAddress)
                {
                    <OsCard Surface="OsCard.CardSurface.Sunk" Class="mb-5">
                        <AddressForm @ref="_addressForm" Model="_newAddress" ShowLabel="true" />
                        <div class="os-card__actions">
                            <OsButton OnClick="AddAddressAsync" Loading="_addingAddress">@L["Common.Save"]</OsButton>
                            <OsButton Variant="OsButton.ButtonVariant.Ghost" OnClick="() => _showAddAddress = false">
                                @L["Common.Cancel"]
                            </OsButton>
                        </div>
                    </OsCard>
                }

                @if (!_profile.Addresses.Any())
                {
                    <OsEmptyState Icon="@Icons.Material.Outlined.Home" Title="@L["Profile.NoAddresses"]" Compact="true" />
                }
                else
                {
                    <div class="os-rows">
                        @foreach (var addr in _profile.Addresses)
                        {
                            <div class="os-row">
                                <div class="os-row__main">
                                    <span class="os-row__title">
                                        @addr.Label
                                        @if (addr.IsDefault)
                                        {
                                            <OsStatusChip Tone="StatusTone.Accent" Text="@L["Profile.DefaultAddress"]" Size="OsStatusChip.ChipSize.Sm" Class="ml-2" />
                                        }
                                    </span>
                                    <span>@addr.FirstName @addr.LastName</span>
                                    <span class="os-row__meta">@addr.Street, @addr.PostalCode @addr.City, @addr.Country</span>
                                </div>
                                <div class="os-row__end">
                                    @if (!addr.IsDefault)
                                    {
                                        <OsIconButton Icon="@Icons.Material.Outlined.Star"
                                                      AriaLabel="@L["Profile.SetDefault"]"
                                                      OnClick="@(() => SetDefaultAsync(addr.Id))" />
                                    }
                                    <OsIconButton Icon="@Icons.Material.Outlined.Delete"
                                                  AriaLabel="@L["Profile.DeleteAddressAria"]"
                                                  OnClick="@(() => DeleteAddressAsync(addr))" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </OsCard>
        </MudStack>
    }
</OsSection>

@code {
    private ProfileDto? _profile;
    private bool _loading = true;
    private bool _saving;
    private bool _addingAddress;
    private bool _showAddAddress;
    private string _displayName = string.Empty;
    private string _email = string.Empty;

    private AddressForm _addressForm = default!;
    private readonly AddressFormModel _newAddress = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await UserProfile.GetOrCreateProfileAsync();
            _profile = result.Value;
            if (!result.IsSuccess)
                Snackbar.ShowApiError(result.Error);
            if (_profile is not null)
            {
                _displayName = _profile.DisplayName;
                _email = _profile.Email;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveProfileAsync()
    {
        _saving = true;
        try
        {
            var result = await UserProfile.UpdateProfileAsync(new UpdateProfileRequest(_displayName, _email));
            if (result.IsSuccess)
            {
                _profile = result.Value;
                Snackbar.ShowSuccess(L["Profile.Saved"]);
            }
            else
            {
                Snackbar.ShowApiError(result.Error);
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task AddAddressAsync()
    {
        if (!await _addressForm.ValidateAsync())
            return;

        _addingAddress = true;
        try
        {
            var result = await UserProfile.AddAddressAsync(_newAddress.ToCreateAddressRequest());
            if (!result.IsSuccess)
            {
                Snackbar.ShowApiError(result.Error);
                return;
            }

            _showAddAddress = false;
            _newAddress.Clear();
            await ReloadProfileAsync();
            Snackbar.ShowSuccess(L["Profile.AddressSaved"]);
        }
        finally
        {
            _addingAddress = false;
        }
    }

    private async Task DeleteAddressAsync(AddressDto address)
    {
        var confirmed = await ConfirmDialog.ShowAsync(
            Dialogs,
            L["Profile.DeleteAddressTitle"],
            L["Profile.DeleteAddressMessage", address.Label],
            L["Common.Delete"],
            danger: true);

        if (!confirmed)
            return;

        var result = await UserProfile.DeleteAddressAsync(address.Id);
        if (!result.IsSuccess)
        {
            Snackbar.ShowApiError(result.Error);
            return;
        }

        await ReloadProfileAsync();
        Snackbar.ShowInfo(L["Profile.AddressDeleted"]);
    }

    private async Task SetDefaultAsync(Guid id)
    {
        var result = await UserProfile.SetDefaultAddressAsync(id);
        if (!result.IsSuccess)
        {
            Snackbar.ShowApiError(result.Error);
            return;
        }

        await ReloadProfileAsync();
    }

    private async Task ReloadProfileAsync() =>
        _profile = (await UserProfile.GetOrCreateProfileAsync()).Value;
}
