@page "/account/orders"
@attribute [Authorize]
@inject IOrderingClient Ordering
@inject ISnackbar Snackbar
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Orders.PageTitle"]</PageTitle>

<OsPageHeader Title="@L["Account.MyOrders"]" Subtitle="@L["Orders.HeroSubtitle"]" Narrow="true" />

<OsSection Padding="OsSection.SectionPadding.Sm" Width="OsSection.SectionWidth.Narrow">
    @if (_loading)
    {
        <OsListSkeleton Rows="3" />
    }
    else if (_orders.Count == 0)
    {
        <OsEmptyState Icon="@Icons.Material.Outlined.ShoppingBag"
                      Title="@L["Orders.EmptyHeading"]"
                      Body="@L["Orders.EmptyBody"]"
                      ActionText="@L["Orders.Discover"]"
                      ActionHref="/shop"
                      ActionIcon="@Icons.Material.Outlined.Storefront" />
    }
    else
    {
        <div class="pg-orders__list">
            @foreach (var order in _orders)
            {
                <OsCard @key="order.Id" Href="@($"/account/orders/{order.Id}")" Padding="OsCard.CardPadding.Lg" Class="pg-order-card">
                    <div class="pg-order-card__head">
                        <div class="pg-order-card__id">
                            <OsEyebrow Text="@L["Orders.OrderNumber"]" Tone="OsEyebrow.EyebrowTone.Muted" Rule="false" />
                            <span class="pg-order-card__number os-mono">#@order.Id.ToString("N")[..8].ToUpperInvariant()</span>
                            <span class="os-row__meta os-mono">@Formatting.DateTime(order.CreatedAt.ToLocalTime())</span>
                        </div>
                        <OsStatusChip Tone="StatusPresentation.OrderTone(order.Status)"
                                      Text="@L[StatusPresentation.OrderLabelKey(order.Status)]"
                                      Dot="true" />
                    </div>

                    <div class="os-rows pg-order-card__lines">
                        @foreach (var line in order.Items)
                        {
                            <div class="os-row">
                                <span class="os-row__main"><span class="os-num">@line.Quantity ×</span> @line.ProductName</span>
                                <OsPrice Value="line.Price * line.Quantity" Size="OsPrice.PriceSize.Sm" Muted="true" />
                            </div>
                        }
                    </div>

                    <div class="pg-order-card__foot">
                        <span class="os-row__meta">
                            @order.ShippingAddress.FirstName @order.ShippingAddress.LastName, @order.ShippingAddress.City
                        </span>
                        <OsPrice Value="order.Total" Size="OsPrice.PriceSize.Lg" />
                    </div>
                </OsCard>
            }
        </div>
    }
</OsSection>

@code {
    private List<OrderDto> _orders = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Ordering.GetOrdersByCustomerAsync();
            if (result.IsSuccess)
                _orders = [.. result.Value!.OrderByDescending(o => o.CreatedAt)];
            else
                Snackbar.ShowApiError(result.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
