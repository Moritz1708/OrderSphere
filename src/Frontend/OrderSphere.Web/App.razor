@implements IDisposable
@inject ThemeState ThemeState
@inject IStringLocalizer<AppStrings> L

@* The four MudBlazor providers live here, above the router, so both layouts
   share one instance each. Dark mode is a palette switch on this provider; the
   CSS side follows html[data-theme], set before first paint by theme-boot.js.
   System preference is sampled once at boot and never overrides a stored
   choice, hence ObserveSystemDarkModeChange="false". *@
<MudThemeProvider Theme="ThemeState.Theme"
                  IsDarkMode="ThemeState.IsDarkMode"
                  ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <div class="os-route-authorizing">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>@L["NotFound.PageTitle"]</PageTitle>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <section class="os-notfound">
                    <span class="os-eyebrow">404</span>
                    <h1 class="os-notfound__title">@L["NotFound.Title"]</h1>
                    <p class="os-notfound__body">@L["NotFound.Body"]</p>
                    <div class="os-notfound__actions">
                        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">
                            @L["NotFound.GoHome"]
                        </MudButton>
                        <MudButton Href="/shop" Variant="Variant.Text" Color="Color.Default">
                            @L["Nav.Shop"]
                        </MudButton>
                    </div>
                </section>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    protected override void OnInitialized() => ThemeState.OnChange += OnThemeChanged;

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeState.OnChange -= OnThemeChanged;
}
