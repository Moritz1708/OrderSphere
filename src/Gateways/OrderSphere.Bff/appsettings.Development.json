{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "OrderSphere": "Debug",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Yarp": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Oidc": {
    "Authority": "https://ordersphere-dev.eu.auth0.com/",
    "ClientId": "B70xhPsEf7EBrKbpZiUZHoXmBIATbrDO"
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-products-public": {
        "ClusterId": "api-gateway",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/products/{**catch-all}",
          "Methods": [ "GET", "HEAD" ]
        },
        "AuthorizationPolicy": "anonymous"
      },
      "catalog-categories-public": {
        "ClusterId": "api-gateway",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/categories/{**catch-all}",
          "Methods": [ "GET", "HEAD" ]
        },
        "AuthorizationPolicy": "anonymous"
      },
      "catalog-brands-public": {
        "ClusterId": "api-gateway",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/brands/{**catch-all}",
          "Methods": [ "GET", "HEAD" ]
        },
        "AuthorizationPolicy": "anonymous"
      },
      "catalog-reviews-public": {
        "ClusterId": "api-gateway",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/reviews/{**catch-all}",
          "Methods": [ "GET", "HEAD" ]
        },
        "AuthorizationPolicy": "anonymous"
      },
      "stripe-webhook": {
        "ClusterId": "api-gateway",
        "Order": -1,
        "Match": {
          "Path": "/webhooks/stripe",
          "Methods": [ "POST" ]
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          { "PathSet": "/api/v1/payments/webhooks/stripe" }
        ]
      },
      "to-gateway": {
        "ClusterId": "api-gateway",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api-gateway": {
        "Destinations": {
          "gateway-default": {
            "Address": "https://ordersphere-apigateway"
          }
        }
      }
    }
  }
}
