{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "OrderSphere": "Information",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ExchangeRates": {
    "BaseCurrency": "EUR",
    "Rates": {
      "USD": 1.08,
      "GBP": 0.85,
      "CHF": 0.97
    }
  },
  "Oidc": {
    "Authority": "https://ordersphere-dev.eu.auth0.com/",
    "ClientId": "B70xhPsEf7EBrKbpZiUZHoXmBIATbrDO",
    "Audience": "https://api.ordersphere.dev",
    "RolesClaim": "https://ordersphere.dev/roles"
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-products-public": {
        "ClusterId": "api-gateway",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/products/{**catch-all}",
          "Methods": [ "GET", "HEAD" ]
        },
        "AuthorizationPolicy": "anonymous"
      },
      "catalog-categories-public": {
        "ClusterId": "api-gateway",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/categories/{**catch-all}",
          "Methods": [ "GET", "HEAD" ]
        },
        "AuthorizationPolicy": "anonymous"
      },
      "catalog-brands-public": {
        "ClusterId": "api-gateway",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/brands/{**catch-all}",
          "Methods": [ "GET", "HEAD" ]
        },
        "AuthorizationPolicy": "anonymous"
      },
      "catalog-reviews-public": {
        "ClusterId": "api-gateway",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/reviews/{**catch-all}",
          "Methods": [ "GET", "HEAD" ]
        },
        "AuthorizationPolicy": "anonymous"
      },
      "to-gateway": {
        "ClusterId": "api-gateway",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api-gateway": {
        "Destinations": {
          "gateway-default": {
            "Address": "https://ordersphere-apigateway"
          }
        }
      }
    }
  },
  "OpenTelemetry": {
    "TracesSampleRatio": 1.0
  }
}
